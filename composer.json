{
    "name": "drupal/legacy-project",
    "description": "Project template for Drupal projects with composer following drupal/drupal layout",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": {
        "tiny_slider": {
            "type": "package",
            "package": {
                "name": "ganlanyuan/tiny-slider",
                "version": "2.9.3",
                "type": "drupal-library",
                "dist": {
                    "type": "zip",
                    "url": "https://github.com/ganlanyuan/tiny-slider/archive/refs/tags/v2.9.3.zip"
                }
            }
        },
        "dynamicweb/swiffy-slider": {
            "type": "package",
            "package": {
                "type": "drupal-library",
                "name": "dynamicweb/swiffy-slider",
                "version": "v1.6.0",
                "dist": {
                    "url": "https://github.com/dynamicweb/swiffy-slider/archive/refs/tags/v1.6.0.zip",
                    "type": "zip"
                }
            }
        },
        "0": {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    },
    "require": {
        "composer/installers": "^2.0",
        "cweagans/composer-patches": "^1.7",
        "drupal/address": "2.0.4",
        "drupal/admin_toolbar": "^3.4",
        "drupal/ai_interpolator_openai": "^1.0@RC",
        "drupal/ajax_loader": "^2.1",
        "drupal/antibot": "^2.0",
        "drupal/asset_injector": "^2.16",
        "drupal/autocomplete_deluxe": "^2.0",
        "drupal/backup_migrate": "^5.0",
        "drupal/batch_jobs": "*",
        "drupal/better_exposed_filters": "^6.0",
        "drupal/bootstrap5": "^3.0",
        "drupal/bootstrap_layout_builder": "2.x-dev@dev",
        "drupal/bpmn_io": "1.1.x-dev@dev",
        "drupal/cancel_button": "^1.4",
        "drupal/coffee": "^1.3",
        "drupal/color_field": "^3.0",
        "drupal/commerce": "2.x-dev@dev",
        "drupal/commerce_feeds": "*",
        "drupal/commerce_pricelist": "*",
        "drupal/commerce_product_taxonomy_filter": "^1.0",
        "drupal/commerce_shipping": "^2.6",
        "drupal/conditional_fields": "4.x-dev@dev",
        "drupal/context": "^5.0@RC",
        "drupal/core-composer-scaffold": "^10.0",
        "drupal/core-project-message": "^10.0",
        "drupal/core-recommended": "^10.0",
        "drupal/core-vendor-hardening": "^10.0",
        "drupal/ds": "^3.15",
        "drupal/dxpr_theme": "^5.1",
        "drupal/dxpr_theme_helper": "^1.0",
        "drupal/eca": "1.1.x-dev@dev",
        "drupal/eca_commerce": "1.0.x-dev@dev",
        "drupal/eca_flag": "^1.0",
        "drupal/eca_tamper": "*",
        "drupal/eca_vbo": "^1.0",
        "drupal/eck": "2.x-dev@dev",
        "drupal/eck_bundle_permissions": "^1.1",
        "drupal/editablefields": "^1.0",
        "drupal/entity_browser": "^2.9",
        "drupal/expandable_formatter": "^1.4",
        "drupal/extlink": "^1.7",
        "drupal/features": "^3.14",
        "drupal/feeds": "^3.0@beta",
        "drupal/feeds_tamper": "*",
        "drupal/field_formatter_class": "^1.6",
        "drupal/field_group": "^3.4",
        "drupal/field_permissions": "^1.3",
        "drupal/field_tools": "^1.0@alpha",
        "drupal/file_resup": "*",
        "drupal/filefield_paths": "*",
        "drupal/flood_control": "^2.3",
        "drupal/geofield_map": "^3.0",
        "drupal/gin": "^3.0@RC",
        "drupal/gin_login": "^2.0",
        "drupal/gin_toolbar": "^1.0@RC",
        "drupal/ief_complex_open": "^1.0@dev",
        "drupal/ief_popup": "*",
        "drupal/ief_table_view_mode": "^3.0",
        "drupal/image_effects": "^3.5",
        "drupal/jquery_ui_touch_punch": "^1.1",
        "drupal/layout_builder_blocks": "*",
        "drupal/layout_builder_component_attributes": "^2.1",
        "drupal/layout_builder_tabs": "^1.0",
        "drupal/layout_custom_section_classes": "^1.0",
        "drupal/mail_login": "^3.0",
        "drupal/mailsystem": "^4.4",
        "drupal/manage_display": "^3.0",
        "drupal/masquerade": "^2.0@RC",
        "drupal/memcache": "^2.5",
        "drupal/mimemail": "1.x-dev@dev",
        "drupal/module_filter": "^4.0",
        "drupal/name": "^1.0@RC",
        "drupal/ng_lightbox": "*",
        "drupal/path_redirect_import": "^2.0",
        "drupal/pathauto": "^1.11",
        "drupal/phone_number": "^2.0@alpha",
        "drupal/physical": "^1.2",
        "drupal/prepopulate": "^2.4",
        "drupal/pwa": "^2.1@beta",
        "drupal/queue_ui": "*",
        "drupal/quicklink": "^2.0",
        "drupal/r4032login": "^2.2",
        "drupal/redirect": "^1.8",
        "drupal/scan_code": "^1.0@beta",
        "drupal/search_api": "^1.31",
        "drupal/select2": "^1.15",
        "drupal/select2_multicheck": "^1.0",
        "drupal/selective_better_exposed_filters": "3.0.x-dev@dev",
        "drupal/shield": "^1.7",
        "drupal/shs": "^2.0@RC",
        "drupal/smtp": "^1.2",
        "drupal/symfony_mailer": "^1.2@beta",
        "drupal/symfony_mailer_log": "^1.2@beta",
        "drupal/taxonomy_manager": "^2.0",
        "drupal/taxonomy_menu_ui": "^3.0",
        "drupal/taxonomy_unique": "^2.5",
        "drupal/tiny_slider": "*",
        "drupal/ultimate_cron": "2.x-dev@dev",
        "drupal/viewfield": "*",
        "drupal/views_bootstrap": "^5.5@alpha",
        "drupal/views_bulk_edit": "^2.9",
        "drupal/views_field_view": "^1.0@beta",
        "drupal/views_infinite_scroll": "^2.0",
        "drupal/views_simple_math_field": "^3.0",
        "drush/drush": "^12.4",
        "dynamicweb/swiffy-slider": "*",
        "ganlanyuan/tiny-slider": "*",
        "geocoder-php/google-maps-provider": "^4.7",
        "giggsey/libphonenumber-for-php": "^8.13",
        "oomphinc/composer-installers-extender": "^2.0",
        "symfony/mailer": "^6.2",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "drupal/core-vendor-hardening": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cweagans/composer-patches": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true,
            "oomphinc/composer-installers-extender": true
        },
        "sort-packages": true,
        "preferred-install": {
            "*": "dist"
        },
        "audit": {
            "block-insecure": false
        }
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "./"
            },
            "file-mapping": {
                "[web-root]/.htaccess": false
            }
        },
        "installer-types": [
            "npm-asset"
        ],
        "composer-exit-on-patch-failure": true,
        "patches": {
            "drupal/inline_entity_form": {
                "Fix Oops on IEF Cancel when entities is NULL (#3516478)": "patches/ief-close-all-forms-null-entities.patch"
            }
        },
        "merge-plugin": {
            "include": [
                "modules/contrib/charts/modules/charts_billboard/composer.json"
            ]
        },
        "installer-paths": {
            "core": [
                "type:drupal-core"
            ],
            "libraries/{$name}": [
                "type:drupal-library"
            ],
            "modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the Acta project template!                      </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/installing-drupal",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        }
    },
    "require-dev": {
        "drupal/upgrade_status": "^4.3"
    }
}
