{
    "name": "drupal/legacy-project",
    "description": "Project template for Drupal projects with composer following drupal/drupal layout",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": {
        "tiny_slider": {
            "type": "package",
            "package": {
                "name": "ganlanyuan/tiny-slider",
                "version": "2.9.3",
                "type": "drupal-library",
                "dist": {
                    "type": "zip",
                    "url": "https://github.com/ganlanyuan/tiny-slider/archive/refs/tags/v2.9.3.zip"
                }
            }
        },
        "dynamicweb/swiffy-slider": {
            "type": "package",
            "package": {
                "type": "drupal-library",
                "name": "dynamicweb/swiffy-slider",
                "version": "v1.6.0",
                "dist": {
                    "url": "https://github.com/dynamicweb/swiffy-slider/archive/refs/tags/v1.6.0.zip",
                    "type": "zip"
                }
            }
        },
        "0": {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    },
    "require": {
        "composer/installers": "^2.0",
        "cweagans/composer-patches": "^1.7",
        "drupal/address": "2.0.4",
        "drupal/admin_toolbar": "^3.6",
        "drupal/ajax_loader": "^2.1",
        "drupal/antibot": "^2.0",
        "drupal/asset_injector": "^2.16",
        "drupal/backup_migrate": "^5.1",
        "drupal/better_exposed_filters": "^7.1",
        "drupal/bootstrap5": "^4.0",
        "drupal/bootstrap_layout_builder": "^2.2",
        "drupal/bootstrap_styles": "^1.2",
        "drupal/bpmn_io": "^2.0",
        "drupal/cancel_button": "^1.5",
        "drupal/coffee": "^2.0",
        "drupal/color": "1.0.3",
        "drupal/color_field": "^3.0",
        "drupal/conditional_fields": "4.0.0-alpha6",
        "drupal/context": "5.0.0-rc2",
        "drupal/core-composer-scaffold": "^10.0",
        "drupal/core-project-message": "^10.0",
        "drupal/core-recommended": "^10.0",
        "drupal/core-vendor-hardening": "^10.0",
        "drupal/csv_serialization": "^4.0",
        "drupal/draggableviews": "2.1.4",
        "drupal/ds": "^3.15",
        "drupal/dxpr_theme": "^8.1",
        "drupal/dxpr_theme_helper": "^3.1",
        "drupal/eca": "^2.1",
        "drupal/eca_flag": "^2.0",
        "drupal/eca_tamper": "^2.0",
        "drupal/eck": "^2.1",
        "drupal/eck_bundle_permissions": "^1.1.2",
        "drupal/editablefields": "^1.0.2",
        "drupal/entity": "^1.6",
        "drupal/entity_browser": "^2.9",
        "drupal/entity_browser_vertical": "^1.1.1",
        "drupal/epp": "^1.7",
        "drupal/extlink": "^2.0",
        "drupal/feeds": "^3.0@beta",
        "drupal/feeds_tamper": "2.0.0-rc1",
        "drupal/field_formatter_class": "^1.9",
        "drupal/field_group": "^4.0",
        "drupal/field_label": "^1.5",
        "drupal/field_permissions": "^1.5",
        "drupal/file_uploader": "1.1.0",
        "drupal/file_uploader_uppy": "^1.1",
        "drupal/filefield_paths": "1.0.0-rc1",
        "drupal/flag": "^5.0",
        "drupal/float_labels": "^2.0",
        "drupal/flood_control": "^3.0",
        "drupal/gin": "^4.0",
        "drupal/gin_login": "^2.0",
        "drupal/gin_toolbar": "^2.0",
        "drupal/ief_table_view_mode": "^3.0",
        "drupal/inline_entity_form": "^3.0",
        "drupal/jquery_ui": "^1.7",
        "drupal/jquery_ui_autocomplete": "^2.1",
        "drupal/jquery_ui_menu": "^2.1",
        "drupal/layout_builder_component_attributes": "^2.3",
        "drupal/layout_custom_section_classes": "^1.0",
        "drupal/mail_login": "4.2.2",
        "drupal/mailsystem": "^4.4",
        "drupal/manage_display": "^3.0",
        "drupal/markup": "^2.0",
        "drupal/masquerade": "^2.2",
        "drupal/media_library_form_element": "^2.1",
        "drupal/mimemail": "^2.0",
        "drupal/module_filter": "^5.0",
        "drupal/name": "^1.5",
        "drupal/pathauto": "^1.15",
        "drupal/pdf_serialization": "2.2.0",
        "drupal/phone_number": "^2.0@alpha",
        "drupal/pwa": "2.1.0-beta7",
        "drupal/quicktabs": "^4.0",
        "drupal/r4032login": "^2.2",
        "drupal/redirect": "^1.13",
        "drupal/scan_code": "^1.0@beta",
        "drupal/select2": "^2.0",
        "drupal/simple_popup_views": "1.2.0",
        "drupal/smtp": "^1.2",
        "drupal/tamper": "^1.0",
        "drupal/taxonomy_unique": "^2.6",
        "drupal/token": "^1.14",
        "drupal/ultimate_cron": "2.0.0-beta1",
        "drupal/verf": "^2.1",
        "drupal/viewfield": "^3.0@beta",
        "drupal/views_aggregator": "2.1.1",
        "drupal/views_bootstrap": "^5.5@alpha",
        "drupal/views_bulk_edit": "^3.0",
        "drupal/views_bulk_operations": "^4.2.7",
        "drupal/views_conditional": "1.10.0",
        "drupal/views_data_export": "^1.10",
        "drupal/views_entity_form_field": "1.0.0",
        "drupal/views_field_view": "^1.0",
        "drupal/views_infinite_scroll": "^2.0.3",
        "drupal/views_simple_math_field": "^3.0",
        "drupal/xls_serialization": "^2.1",
        "drush/drush": "^12.4",
        "dynamicweb/swiffy-slider": "1.6.0",
        "ganlanyuan/tiny-slider": "2.9.3",
        "geocoder-php/google-maps-provider": "^4.7",
        "giggsey/libphonenumber-for-php": "^8.13",
        "oomphinc/composer-installers-extender": "^2.0",
        "symfony/mailer": "^6.2"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "drupal/core-vendor-hardening": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cweagans/composer-patches": true,
            "php-http/discovery": true,
            "oomphinc/composer-installers-extender": true
        },
        "sort-packages": true,
        "preferred-install": {
            "*": "dist"
        },
        "audit": {
            "block-insecure": false
        }
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "./"
            },
            "file-mapping": {
                "[web-root]/.htaccess": false,
                "[project-root]/.gitattributes": {
                    "append": "scaffold/gitattributes-append.txt"
                }
            }
        },
        "installer-types": [
            "npm-asset"
        ],
        "composer-exit-on-patch-failure": true,
        "patches": {
            "drupal/editablefields": {
                "Declarar compatibilidad con Drupal 11": "patches/editablefields-declarar-drupal-11.patch"
            },
            "drupal/inline_entity_form": {
                "Fix Oops on IEF Cancel when entities is NULL (#3516478)": "patches/ief-close-all-forms-null-entities.patch"
            },
            "drupal/pdf_serialization": {
                "Add an interface for PdfManager class (#3286248-4)": "patches/pdf_serialization-add-pdfmanager-interface-4.patch",
                "Update PdfEncoder.php (#3286248-6)": "patches/pdf_serialization-update-pdfencoder-6.patch",
                "Declarar compatibilidad con Drupal 11": "patches/pdf-serialization-declarar-drupal-11.patch"
            },
            "drupal/simple_popup_views": {
                "Declarar compatibilidad con Drupal 11": "patches/simple-popup-views-declarar-drupal-11.patch"
            },
            "drupal/views_aggregator": {
                "Fix TypeError on empty multi-value fields in getCellRaw()": "patches/views_aggregator-getcellraw-empty-array.patch"
            },
            "drupal/verf": {
                "Update autocomplete (#12)": "patches/verf-update-autocomplete-12.patch",
                "Introduce correct hook, deprecate the old one (#14)": "patches/verf-introduce-correct-hook-14.patch",
                "Offer only the values actually in use (#2998697-26)": "patches/verf-load-only-used-options-2998697-26.patch"
            },
            "drupal/select2": {
                "Guard against an undefined config (#3279387-6)": "patches/select2-js-error-when-config-is-undefined-3279387-6.patch"
            },
            "drupal/tamper": {
                "Cast to float before multiplying, so decimals survive": "patches/tamper-math-multiplication-cast-to-float.patch"
            },
            "drupal/views_entity_form_field": {
                "AJAX in the editable table, plus the local state it was installed with": "patches/views_entity_form_field-ajax-and-local-state.patch"
            }
        },
        "installer-paths": {
            "core": [
                "type:drupal-core"
            ],
            "libraries/{$name}": [
                "type:drupal-library"
            ],
            "modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the Acta project template!                      </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/installing-drupal",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        }
    },
    "require-dev": {
        "drupal/upgrade_status": "^4.3"
    }
}
