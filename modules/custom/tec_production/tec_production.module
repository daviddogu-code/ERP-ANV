<?php

/**
 * @file
 * TEC Production: orders queue, production log, reports, stock control.
 *
 * See README.md for the 4-phase build plan and agreed business rules.
 */

/**
 * Implements hook_page_attachments().
 */
function tec_production_page_attachments(array &$attachments) {
  // Site-wide fix: keep the DXPR sticky header below the Gin admin toolbar
  // (see css/dxpr-gin-header-fix.css). Harmless on pages without DXPR.
  $attachments['#attached']['library'][] = 'tec_production/dxpr_gin_header_fix';

  // Site-wide fix: give unchecked checkboxes a border you can see. Bootstrap
  // paints them with a DXPR colour that is nearly the page background (see
  // css/dxpr-checkbox-fix.css). Harmless anywhere the box is already visible.
  $attachments['#attached']['library'][] = 'tec_production/dxpr_checkbox_fix';
}

/**
 * Implements hook_entity_extra_field_info().
 *
 * Puts the one purchase status where a display can place it.
 *
 * The order card and the printout used to show the stored open/closed flag,
 * which answers a different question from the one people were reading it for:
 * an order can be open and half in the warehouse, or closed because the missing
 * half was written off. Meanwhile the supplier list and the purchase control
 * screen had richer answers of their own and the three did not agree.
 *
 * There is no field to point at, because four of the seven readings are worked
 * out rather than stored, so it comes in as an extra field. Display Suite and
 * Layout Builder both place these like any other, which is what lets the card
 * and the PDF use it without either of them learning anything new.
 */
function tec_production_entity_extra_field_info() {
  $extra = [];
  $extra['tec_order']['tec_purchase_order']['display']['tec_progress'] = [
    'label' => t('Status'),
    'description' => t('Where the order has got to: Open, the three steps set by hand, then Delivered, Closed or Cancelled. Worked out from the receipts and the invoice.'),
    'weight' => 0,
    'visible' => FALSE,
  ];

  return $extra;
}

/**
 * Implements hook_ENTITY_TYPE_view() for tec_order.
 *
 * Draws the status pill wherever a display has asked for it.
 */
function tec_production_tec_order_view(array &$build, $entity, $display, $view_mode) {
  if ($entity->bundle() !== 'tec_purchase_order') {
    return;
  }

  // Layout Builder keeps its components in sections instead of in the display's
  // content, and getComponent() only answers from there for things that carry a
  // formatter, which an extra field never does. So on those displays it always
  // says no, and asking it would mean the card never draws the pill at all.
  //
  // Building it unconditionally is safe there and only there: Layout Builder
  // leaves a placeholder for each extra field and afterwards either moves this
  // into it or throws it away. On an ordinary display the question is real --
  // nothing would remove an unwanted field -- and getComponent() answers it
  // properly.
  if (!$display->getThirdPartySetting('layout_builder', 'enabled') && !$display->getComponent('tec_progress')) {
    return;
  }

  $progress = \Drupal\tec_production\Purchasing::progress($entity);
  $build['tec_progress'] = [
    '#type' => 'html_tag',
    '#tag' => 'span',
    '#value' => \Drupal\tec_production\Purchasing::PROGRESS[$progress] ?? $progress,
    '#attributes' => ['class' => ['tec-po-status', 'tec-po-status--' . $progress]],
    '#attached' => ['library' => ['tec_production/purchase_progress']],
  ];

  // The reading comes from the lines, and saving a line invalidates the line
  // rather than the order that holds it. Without this the card would keep
  // showing "Nothing received" after a delivery was booked in.
  foreach ($entity->get('field_tec_line_items')->referencedEntities() as $line) {
    $build['tec_progress']['#cache']['tags'] = array_merge(
      $build['tec_progress']['#cache']['tags'] ?? [],
      $line->getCacheTags()
    );
  }
}

/**
 * Implements hook_views_pre_render().
 *
 * Hands the purchase draft the VAT rate of the order it is editing.
 *
 * Every other screen draws its own foot on the server. The draft cannot: it is
 * a form, and the whole point is that the figures move as quantities are typed,
 * before anything is saved. So its total is added up in the browser, and the
 * browser has no way of knowing the rate -- it is on the order, not on any of
 * the rows in front of it.
 *
 * Nothing is handed over unless the order really is a purchase order with a
 * rate stamped on it. The sales draft runs the same script, and it must keep
 * showing the single total it has always shown until sales VAT is a question
 * somebody has answered.
 */
function tec_production_views_pre_render(\Drupal\views\ViewExecutable $view): void {
  if ($view->id() !== 'tec_order_sales_order_line_items') {
    return;
  }
  // By path rather than by display id, because 'po/draft' says which screen
  // this is and 'page_1' does not.
  if (!str_starts_with((string) $view->getPath(), 'po/draft')) {
    return;
  }

  $id = (int) ($view->args[0] ?? 0);
  $order = $id > 0 ? \Drupal::entityTypeManager()->getStorage('tec_order')->load($id) : NULL;
  if (!$order) {
    return;
  }

  $sums = \Drupal\tec_production\Vat::breakdown($order);
  if (!$sums || $sums['rate'] === NULL) {
    return;
  }

  $view->element['#attached']['drupalSettings']['tecPurchaseVat']['rate'] = $sums['rate'];
}

/**
 * Implements hook_ENTITY_TYPE_presave() for tec_order.
 *
 * Stamps a new order with the two things it must not be left to decide for
 * itself: its number, and the VAT rate it was raised under.
 *
 * Both only happen on creation, and for the same reason. These two end up
 * printed on a document that is sent to somebody outside the company, and a
 * document that quietly says something different next month is worse than no
 * document. What a purchase order says is what was agreed on the day.
 */
function tec_production_tec_order_presave($order) {
  if (!$order->isNew()) {
    return;
  }

  // The number. Here and nowhere else: before this, three places built order
  // numbers -- two ECA processes and the purchase list -- and all three could
  // hand out a number another order already had. Whoever creates an order does
  // not get a say in what it is called, which is the point, because the title
  // of an order is its number and a number nobody controls is not a number.
  if (\Drupal\tec_production\OrderNumber::handles($order->bundle())) {
    $name = \Drupal\tec_production\OrderNumber::forOrder($order);
    if ($name !== '') {
      $order->set('title', $name);
    }
  }

  // The VAT rate, from the supplier's card. Copied rather than looked up on
  // demand so that a supplier registering for VAT in October cannot rewrite
  // what was printed in March. Anything already filled in is left alone: that
  // is somebody deliberately overriding it for a one-off, which is allowed.
  $rate_field = \Drupal\tec_production\Vat::RATE_FIELD;
  if ($order->bundle() === 'tec_purchase_order'
    && $order->hasField($rate_field)
    && $order->get($rate_field)->isEmpty()) {

    $supplier_field = \Drupal\tec_production\OrderNumber::contactField($order->bundle());
    $supplier = $supplier_field && $order->hasField($supplier_field) && !$order->get($supplier_field)->isEmpty()
      ? $order->get($supplier_field)->entity
      : NULL;

    $order->set($rate_field, \Drupal\tec_production\Vat::forContact($supplier));
  }
}

/**
 * Implements hook_contextual_links_alter().
 *
 * Site-wide fix: draggableviews attaches an "Order view" contextual link to
 * every views display and points it at the display holding the drag-sort
 * (draggableviews_contextual_links_alter()). When that display is a page
 * whose path has a required contextual filter (e.g. tec_products page_2 at
 * /tec_crm/%/reorder), the URL cannot be generated and the whole
 * /contextual/render request fails with MissingMandatoryParametersException,
 * showing the "Oops, something went wrong" banner on any page embedding the
 * view. Drop the link when its route needs parameters we cannot supply.
 * This hook runs after draggableviews' one (alphabetical module order).
 */
function tec_production_contextual_links_alter(array &$links, $group, array $route_parameters) {
  $key = 'draggableviews.view.order_view';
  if ($group !== $key || empty($links[$key]['route_name'])) {
    return;
  }
  try {
    $route = \Drupal::service('router.route_provider')->getRouteByName($links[$key]['route_name']);
    foreach ($route->compile()->getPathVariables() as $name) {
      if (!isset($route_parameters[$name]) && !$route->hasDefault($name)) {
        unset($links[$key]);
        return;
      }
    }
  }
  catch (\Exception $e) {
    unset($links[$key]);
  }
}

/**
 * Implements hook_ENTITY_TYPE_insert() for tec_production_entry.
 */
function tec_production_tec_production_entry_insert($entry) {
  _tec_production_recompute_produced((int) $entry->get('order_id')->target_id);
}

/**
 * Implements hook_ENTITY_TYPE_update() for tec_production_entry.
 */
function tec_production_tec_production_entry_update($entry) {
  _tec_production_recompute_produced((int) $entry->get('order_id')->target_id);
}

/**
 * Implements hook_ENTITY_TYPE_delete() for tec_production_entry.
 */
function tec_production_tec_production_entry_delete($entry) {
  _tec_production_recompute_produced((int) $entry->get('order_id')->target_id);
}

/**
 * Recompute field_tec_produced (X on the queue) as SUM of log entries.
 *
 * The Daily Production Log is the sole source of X. The queue form never
 * writes this field. After the last entry is deleted, the SUM is 0.
 */
function _tec_production_recompute_produced(int $order_id): void {
  if ($order_id <= 0) {
    return;
  }
  $order = \Drupal::entityTypeManager()->getStorage('tec_order')->load($order_id);
  if (!$order || !$order->hasField('field_tec_produced')) {
    return;
  }
  $result = \Drupal::entityQueryAggregate('tec_production_entry')
    ->condition('order_id', $order_id)
    ->aggregate('quantity', 'SUM')
    ->accessCheck(FALSE)
    ->execute();
  $sum = (int) ($result[0]['quantity_sum'] ?? 0);
  if ((int) $order->get('field_tec_produced')->value !== $sum) {
    $order->set('field_tec_produced', $sum);
    $order->save();
  }
}
