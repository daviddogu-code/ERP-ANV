<?php

/**
 * @file
 * TEC Production: orders queue, production log, reports, stock control.
 *
 * See README.md for the 4-phase build plan and agreed business rules.
 */

/**
 * Implements hook_page_attachments().
 */
function tec_production_page_attachments(array &$attachments) {
  // Site-wide fix: keep the DXPR sticky header below the Gin admin toolbar
  // (see css/dxpr-gin-header-fix.css). Harmless on pages without DXPR.
  $attachments['#attached']['library'][] = 'tec_production/dxpr_gin_header_fix';

  // Site-wide fix: give unchecked checkboxes a border you can see. Bootstrap
  // paints them with a DXPR colour that is nearly the page background (see
  // css/dxpr-checkbox-fix.css). Harmless anywhere the box is already visible.
  $attachments['#attached']['library'][] = 'tec_production/dxpr_checkbox_fix';

  // Sales status colours: the order lists still wrap the label in a div
  // whose class is the words of the label. This file paints those and the
  // pills. Harmless on pages without an order status.
  $attachments['#attached']['library'][] = 'tec_production/sales_status';
}

/**
 * Implements hook_entity_extra_field_info().
 *
 * Puts the one purchase status where a display can place it.
 *
 * The order card and the printout used to show the stored open/closed flag,
 * which answers a different question from the one people were reading it for:
 * an order can be open and half in the warehouse, or closed because the missing
 * half was written off. Meanwhile the supplier list and the purchase control
 * screen had richer answers of their own and the three did not agree.
 *
 * There is no field to point at, because four of the seven readings are worked
 * out rather than stored, so it comes in as an extra field. Display Suite and
 * Layout Builder both place these like any other, which is what lets the card
 * and the PDF use it without either of them learning anything new.
 */
function tec_production_entity_extra_field_info() {
  $extra = [];
  $extra['tec_order']['tec_purchase_order']['display']['tec_progress'] = [
    'label' => t('Status'),
    'description' => t('Where the order has got to: Open, the three steps set by hand, then Delivered, Closed or Cancelled. Worked out from the receipts and the invoice.'),
    'weight' => 0,
    'visible' => FALSE,
  ];
  $extra['tec_order']['tec_purchase_order']['display']['tec_invoice'] = [
    'label' => t('Invoice'),
    'description' => t("The supplier's invoice, scanned or photographed. Shown on the order card so it can be opened after the row has left Purchase Control, and replaced from there if the scan is wrong."),
    'weight' => 6,
    'visible' => FALSE,
  ];

  return $extra;
}

/**
 * Implements hook_preprocess_field().
 *
 * The order card printed the status as plain text. Oscar's colours only
 * matched two labels. This draws the factory pill from the stored value.
 */
function tec_production_preprocess_field(array &$variables): void {
  if (($variables['element']['#field_name'] ?? '') !== 'field_tec_order_status') {
    return;
  }
  $entity = $variables['element']['#object'] ?? NULL;
  if (!$entity || $entity->getEntityTypeId() !== 'tec_order' || $entity->bundle() !== 'tec_sales_order') {
    return;
  }
  if (empty($variables['items'][0])) {
    return;
  }
  $variables['items'][0]['content'] = \Drupal\tec_production\SalesStatus::pill(
    \Drupal\tec_production\SalesStatus::of($entity)
  );
}

/**
 * Implements hook_entity_view_alter().
 *
 * The card still has Oscar's "Update to Accounting verified" flag. That
 * flag always wrote the same status. The slot now advances one step on
 * the factory map, the same click as the arrow on /o/queue.
 */
function tec_production_entity_view_alter(array &$build, \Drupal\Core\Entity\EntityInterface $entity, \Drupal\Core\Entity\Display\EntityViewDisplayInterface $display): void {
  if ($entity->getEntityTypeId() !== 'tec_order' || $entity->bundle() !== 'tec_sales_order') {
    return;
  }
  if (isset($build['flag_tec_order_accounting_verified'])) {
    $build['flag_tec_order_accounting_verified'] = \Drupal\tec_production\SalesStatus::advanceBuild($entity);
  }
}

/**
 * Implements hook_ENTITY_TYPE_view() for tec_order.
 *
 * Draws the status pill wherever a display has asked for it.
 */
function tec_production_tec_order_view(array &$build, $entity, $display, $view_mode) {
  if ($entity->bundle() === 'tec_sales_order' && isset($build['flag_tec_order_accounting_verified'])) {
    $build['flag_tec_order_accounting_verified'] = \Drupal\tec_production\SalesStatus::advanceBuild($entity);
  }

  if ($entity->bundle() !== 'tec_purchase_order') {
    return;
  }

  // Layout Builder keeps its components in sections instead of in the display's
  // content, and getComponent() only answers from there for things that carry a
  // formatter, which an extra field never does. So on those displays it always
  // says no, and asking it would mean the card never draws the pill at all.
  //
  // Building it unconditionally is safe there and only there: Layout Builder
  // leaves a placeholder for each extra field and afterwards either moves this
  // into it or throws it away. On an ordinary display the question is real --
  // nothing would remove an unwanted field -- and getComponent() answers it
  // properly.
  $layout = (bool) $display->getThirdPartySetting('layout_builder', 'enabled');

  if ($layout || $display->getComponent('tec_progress')) {
    $progress = \Drupal\tec_production\Purchasing::progress($entity);
    $build['tec_progress'] = [
      '#type' => 'html_tag',
      '#tag' => 'span',
      '#value' => \Drupal\tec_production\Purchasing::PROGRESS[$progress] ?? $progress,
      '#attributes' => ['class' => ['tec-po-status', 'tec-po-status--' . $progress]],
      '#attached' => ['library' => ['tec_production/purchase_progress']],
    ];

    // The reading comes from the lines, and saving a line invalidates the line
    // rather than the order that holds it. Without this the card would keep
    // showing "Nothing received" after a delivery was booked in.
    foreach ($entity->get('field_tec_line_items')->referencedEntities() as $line) {
      $build['tec_progress']['#cache']['tags'] = array_merge(
        $build['tec_progress']['#cache']['tags'] ?? [],
        $line->getCacheTags()
      );
    }
  }

  // The scan is an internal paper. The PDF that goes to the supplier must not
  // grow a download even if the extra field is placed there later.
  if ($view_mode !== 'pdf' && ($layout || $display->getComponent('tec_invoice'))) {
    $file = \Drupal\tec_production\Purchasing::invoice($entity);
    $url = \Drupal\tec_production\Purchasing::invoiceUrl($entity);
    if ($file && $url) {
      $build['tec_invoice'] = [
        '#type' => 'container',
        '#attributes' => ['class' => ['tec-po-invoice-wrap']],
        'file' => \Drupal\tec_production\Purchasing::invoicePreview($file, [
          '#type' => 'link',
          '#title' => $file->getFilename(),
          '#url' => $url,
          '#attributes' => [
            'class' => ['tec-po-invoice'],
            'target' => '_blank',
          ],
        ], $url),
        'replace' => [
          '#type' => 'link',
          '#title' => t('Replace'),
          '#url' => \Drupal\tec_production\Purchasing::invoiceDialogUrl($entity),
          '#attributes' => \Drupal\tec_production\Purchasing::invoiceDialogAttributes(['tec-po-invoice-replace']),
        ],
        '#cache' => ['tags' => $entity->getCacheTags()],
        '#attached' => ['library' => ['tec_production/supplier_orders']],
      ];
    }
    else {
      // An empty extra field still has to occupy its placeholder, or Layout
      // Builder prints "Placeholder for the Invoice extra field".
      $build['tec_invoice'] = ['#markup' => ''];
    }
  }
}

/**
 * Implements hook_views_pre_render().
 *
 * Two unrelated jobs share this hook because both have to run before the view
 * is drawn, and Drupal only offers the one hook for that moment.
 *
 * The supplier lists get a stylesheet that keeps each row on one line: the
 * date format wraps at the hyphen, and the action icons stack, unless the
 * cells are told not to wrap.
 *
 * The purchase draft gets the VAT rate of the order it is editing. Every other
 * screen draws its own foot on the server. The draft cannot: it is a form, and
 * the whole point is that the figures move as quantities are typed, before
 * anything is saved. So its total is added up in the browser, and the browser
 * has no way of knowing the rate -- it is on the order, not on any of the rows
 * in front of it.
 *
 * Nothing is handed over unless the order really is a purchase order with a
 * rate stamped on it. The sales draft runs the same script, and it must keep
 * showing the single total it has always shown until sales VAT is a question
 * somebody has answered.
 */
function tec_production_views_pre_render(\Drupal\views\ViewExecutable $view): void {
  if (in_array($view->id(), ['tec_supplier_orders', 'tec_orders_orders'], TRUE)) {
    $view->element['#attached']['library'][] = 'tec_production/supplier_orders';
  }

  if ($view->id() !== 'tec_order_sales_order_line_items') {
    return;
  }
  // By path rather than by display id, because 'po/draft' says which screen
  // this is and 'page_1' does not.
  if (!str_starts_with((string) $view->getPath(), 'po/draft')) {
    return;
  }

  $id = (int) ($view->args[0] ?? 0);
  $order = $id > 0 ? \Drupal::entityTypeManager()->getStorage('tec_order')->load($id) : NULL;
  if (!$order) {
    return;
  }

  $sums = \Drupal\tec_production\Vat::breakdown($order);
  if (!$sums || $sums['rate'] === NULL) {
    return;
  }

  $view->element['#attached']['drupalSettings']['tecPurchaseVat']['rate'] = $sums['rate'];
}

/**
 * Implements hook_views_post_execute().
 *
 * Puts the catalogue in order before anything reads it: brand, product, colour,
 * size.
 *
 * Here and not in hook_views_pre_render() because the screen that matters most
 * is never rendered. The + Order button hands the view to ECA, which executes it
 * and walks the rows creating one line item each, so by the time a pro forma
 * exists the rows have long since been read. This hook runs the moment the query
 * comes back, which is the last point both paths still share.
 *
 * CatalogueOrder has the four levels and why two of them cannot be sorted in
 * SQL.
 */
function tec_production_views_post_execute(\Drupal\views\ViewExecutable $view): void {
  \Drupal\tec_production\CatalogueOrder::apply($view);
}

/**
 * Implements hook_preprocess_HOOK() for views-view-table.html.twig.
 *
 * Gives a sales order's table its last row: how many pieces and how much money.
 *
 * A row of the table and not a block underneath it, because the count has to
 * land under the column it counts, and a figure in a second table can only ever
 * float at the right edge. OrderFoot has the whole of the reasoning, and the
 * list of which two screens get one.
 */
function tec_production_preprocess_views_view_table(array &$variables): void {
  \Drupal\tec_production\OrderFoot::add($variables);
}

/**
 * Implements hook_views_post_render().
 *
 * Makes a brand's catalogue admit what it cannot show.
 *
 * Its rows are sizes, so a product with no colour, or a colour with no size, is
 * missing from a screen that carries the button that created it. BrandGaps has
 * the whole of the reasoning. The notice is hung here and painted later, after
 * Views has wrapped the rows in a form and emptied the footer it came with.
 */
function tec_production_views_post_render(\Drupal\views\ViewExecutable $view, array &$output, $cache): void {
  \Drupal\tec_production\BrandGaps::attach($view, $output);
}

/**
 * Implements hook_ENTITY_TYPE_presave() for tec_order.
 *
 * Stamps an order with the two things it must not be left to decide for itself:
 * its number, and the VAT rate it was raised under.
 *
 * Both end up printed on a document that is sent to somebody outside the
 * company, and a document that quietly says something different next month is
 * worse than no document. What a purchase order says is what was agreed on the
 * day.
 */
function tec_production_tec_order_presave($order) {
  // A name, so that nothing lands in a list as a blank row. Not its number:
  // since 19 August 2026 that waits for somebody to press Save, which is a fact
  // about a form and not about an entity -- see OrderNumber::earn() for why, and
  // tec_production_form_alter() for where.
  \Drupal\tec_production\OrderNumber::provisional($order);

  $rate_field = \Drupal\tec_production\Vat::RATE_FIELD;
  if (!$order->hasField($rate_field) || !$order->get($rate_field)->isEmpty()) {
    return;
  }

  $contact_field = \Drupal\tec_production\OrderNumber::contactField($order->bundle());
  $contact = $contact_field && $order->hasField($contact_field) && !$order->get($contact_field)->isEmpty()
    ? $order->get($contact_field)->entity
    : NULL;

  // Purchases: only at creation, so an old order is not given today's rate.
  // Sales: at creation, and again while the order is still Open if the country
  // was filled in later. A confirmed order that never had a rate keeps none.
  if ($order->bundle() === 'tec_purchase_order' && $order->isNew()) {
    $order->set($rate_field, \Drupal\tec_production\Vat::forContact($contact));
    return;
  }

  if ($order->bundle() === 'tec_sales_order'
    && \Drupal\tec_production\Vat::customerCountry($contact) !== '') {
    $status = $order->hasField('field_tec_order_status')
      ? (string) $order->get('field_tec_order_status')->value
      : '';
    if ($order->isNew() || $status === 'draft' || $status === '') {
      $order->set($rate_field, \Drupal\tec_production\Vat::forCustomer($contact));
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_presave() for tec_product.
 *
 * Gives a product the last place in its brand when it has no place of its own.
 *
 * The order of a brand's products is dragged on its Organize products screen
 * and read by every list of products, the pro forma included -- see
 * CataloguePosition. A product that arrives without a place would sort ahead of
 * all of them, so a new one goes to the end of the list instead, where it
 * disturbs nothing that was put in order on purpose.
 *
 * A new product is given a place even if it arrives with one, because the one
 * route that brings a place along is duplicating a product, and a duplicate
 * sharing its source's place is two products claiming the same row.
 *
 * A product moved to another brand keeps its number and can land in the middle
 * of the new one. Nothing is broken by that -- the screens fall back to the
 * name when two products share a place -- and the next save of that brand's
 * order renumbers the whole list from 1, which is where it sorts itself out.
 */
function tec_production_tec_product_presave($product) {
  $field = \Drupal\tec_production\CataloguePosition::FIELD;
  if ($product->bundle() !== 'tec_product' || !$product->hasField($field)) {
    return;
  }
  if (!$product->isNew() && (int) $product->get($field)->value > 0) {
    return;
  }

  $brand_field = \Drupal\tec_production\CataloguePosition::BRAND_FIELD;
  $brand = $product->hasField($brand_field) && !$product->get($brand_field)->isEmpty()
    ? (int) $product->get($brand_field)->target_id
    : 0;
  if ($brand < 1) {
    // No brand, no list to be part of. It shows up in /orphans instead.
    return;
  }

  $product->set($field, \Drupal\tec_production\CataloguePosition::nextFor($brand));
}

/**
 * Implements hook_form_alter().
 *
 * Puts "earn the number" behind every Save that can mean an order is being kept.
 *
 * Since 19 August 2026 an order is numbered when somebody saves it and not when
 * it is created (OrderNumber::earn() has the why). Being saved by a person is a
 * fact about a form, not about an entity -- code saves orders all day for its
 * own reasons -- so the forms that mean it are named here, and nothing else in
 * the ERP hands out a number except the purchase list, whose button creates the
 * orders and keeps them in one go.
 *
 * Two forms mean it:
 *
 * - The purchase draft screen, /po/draft/N, which is where that work is
 *   done. Matched by the path, because "po/draft" says which screen this is and
 *   "page_1" does not. Save saves the lines -- one entity each -- and
 *   never touches the order behind them, so the handler has to find that order
 *   itself, from the argument in the path. Sales Open is /o/order, a PHP form
 *   whose Place order already earned the number.
 * - The order's own form, a rarer route to the same act.
 *
 * They are wired differently because Drupal takes submit handlers from two
 * places. A views form leaves its button bare, so the form's own list is the one
 * that runs. An entity form's Save carries its own list -- ::submitForm and
 * ::save -- and a button's list wins over the form's, so ours has to go there.
 *
 * Either way it goes last, behind the writing. A number spent on a save that
 * then fell over would be a hole in a customer's sequence, which is the very
 * thing this is here to stop, and the order of the two says what Save means:
 * what the owner typed is kept first, and the order becomes real because of it.
 */
function tec_production_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, string $form_id): void {
  if (_tec_production_draft_screen($form_state)) {
    $form['#after_build'][] = '_tec_production_earn_the_number_last';
    return;
  }

  $entity = _tec_production_form_order($form_state);
  if ($entity && isset($form['actions']['submit']['#submit'])) {
    $form['actions']['submit']['#submit'][] = '_tec_production_earn_the_number';
  }
}

/**
 * Implements #after_build.
 *
 * Adding the handler in the alter hook would put it in front of the one that
 * saves the lines: views_entity_form_field adds that one from a #process
 * callback, and processing happens after every module has had its say on the
 * form. After_build is the next thing to run after processing, so this is the
 * first place from which the end of the list really is the end.
 */
function _tec_production_earn_the_number_last(array $form, \Drupal\Core\Form\FormStateInterface $form_state): array {
  $form['#submit'][] = '_tec_production_earn_the_number';

  return $form;
}

/**
 * Gives the order behind a form the number that pressing Save has earned it.
 *
 * Loaded again rather than taken from the form: on the draft screens the order
 * is not what the form was editing, and on its own form the copy in hand is the
 * one that was just written, so re-reading is the only way to be sure of what is
 * in the database before adding to it.
 */
function _tec_production_earn_the_number(array $form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  $view = _tec_production_draft_screen($form_state);
  $id = $view
    ? (int) ($view->args[0] ?? 0)
    : (int) (($order = _tec_production_form_order($form_state)) ? $order->id() : 0);
  if (!$id) {
    return;
  }

  $order = \Drupal::entityTypeManager()->getStorage('tec_order')->loadUnchanged($id);
  if ($order && \Drupal\tec_production\OrderNumber::earn($order)) {
    $order->save();
  }
}

/**
 * The view behind a draft screen's form, or NULL for any other form.
 *
 * Views does not put its view in the form state, though everyone expects it to:
 * it passes it as a build argument, so that is where it is looked for.
 */
function _tec_production_draft_screen(\Drupal\Core\Form\FormStateInterface $form_state): ?\Drupal\views\ViewExecutable {
  foreach ($form_state->getBuildInfo()['args'] ?? [] as $argument) {
    if ($argument instanceof \Drupal\views\ViewExecutable) {
      $path = (string) $argument->getPath();
      return str_starts_with($path, 'o/draft') || str_starts_with($path, 'po/draft') ? $argument : NULL;
    }
  }

  return NULL;
}

/**
 * The numbered order a form is editing, or NULL for any other form.
 *
 * Deleting is not keeping, so the delete form is left out. It would do no harm
 * -- by the time its submit handlers run there is nothing left to load -- but a
 * number-giving handler hanging off a delete button is a thing somebody would
 * have to think about twice.
 */
function _tec_production_form_order(\Drupal\Core\Form\FormStateInterface $form_state) {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof \Drupal\Core\Entity\EntityFormInterface
    || $form_object->getOperation() === 'delete') {
    return NULL;
  }

  $entity = $form_object->getEntity();
  if ($entity->getEntityTypeId() !== 'tec_order' || !\Drupal\tec_production\OrderNumber::handles($entity->bundle())) {
    return NULL;
  }

  return $entity;
}

/**
 * Implements hook_contextual_links_alter().
 *
 * Site-wide fix: draggableviews attaches an "Order view" contextual link to
 * every views display and points it at the display holding the drag-sort
 * (draggableviews_contextual_links_alter()). When that display is a page
 * whose path has a required contextual filter (e.g. tec_products page_2 at
 * /tec_crm/%/reorder), the URL cannot be generated and the whole
 * /contextual/render request fails with MissingMandatoryParametersException,
 * showing the "Oops, something went wrong" banner on any page embedding the
 * view. Drop the link when its route needs parameters we cannot supply.
 * This hook runs after draggableviews' one (alphabetical module order).
 */
function tec_production_contextual_links_alter(array &$links, $group, array $route_parameters) {
  $key = 'draggableviews.view.order_view';
  if ($group !== $key || empty($links[$key]['route_name'])) {
    return;
  }
  try {
    $route = \Drupal::service('router.route_provider')->getRouteByName($links[$key]['route_name']);
    foreach ($route->compile()->getPathVariables() as $name) {
      if (!isset($route_parameters[$name]) && !$route->hasDefault($name)) {
        unset($links[$key]);
        return;
      }
    }
  }
  catch (\Exception $e) {
    unset($links[$key]);
  }
}

/**
 * Implements hook_ENTITY_TYPE_insert() for tec_production_entry.
 */
function tec_production_tec_production_entry_insert($entry) {
  _tec_production_recompute_produced((int) $entry->get('order_id')->target_id);
}

/**
 * Implements hook_ENTITY_TYPE_update() for tec_production_entry.
 */
function tec_production_tec_production_entry_update($entry) {
  _tec_production_recompute_produced((int) $entry->get('order_id')->target_id);
}

/**
 * Implements hook_ENTITY_TYPE_delete() for tec_production_entry.
 */
function tec_production_tec_production_entry_delete($entry) {
  _tec_production_recompute_produced((int) $entry->get('order_id')->target_id);
}

/**
 * Recompute field_tec_produced (X on the queue) as SUM of log entries.
 *
 * The Daily Production Log is the sole source of X. The queue form never
 * writes this field. After the last entry is deleted, the SUM is 0.
 */
function _tec_production_recompute_produced(int $order_id): void {
  if ($order_id <= 0) {
    return;
  }
  $order = \Drupal::entityTypeManager()->getStorage('tec_order')->load($order_id);
  if (!$order || !$order->hasField('field_tec_produced')) {
    return;
  }
  $result = \Drupal::entityQueryAggregate('tec_production_entry')
    ->condition('order_id', $order_id)
    ->aggregate('quantity', 'SUM')
    ->accessCheck(FALSE)
    ->execute();
  $sum = (int) ($result[0]['quantity_sum'] ?? 0);
  if ((int) $order->get('field_tec_produced')->value !== $sum) {
    $order->set('field_tec_produced', $sum);
    $order->save();
  }
}

/**
 * Creates field_tec_vat_rate on tec_sales_order if it is missing.
 *
 * Safe to run twice. Called from the update hook and from the sales VAT test,
 * because `drush updatedb` on this host often fails before it reaches 10005.
 */
function tec_production_ensure_sales_vat_rate(): void {
  $storage = \Drupal\field\Entity\FieldStorageConfig::loadByName('tec_order', \Drupal\tec_production\Vat::RATE_FIELD);
  if (!$storage) {
    return;
  }

  if (!\Drupal\field\Entity\FieldConfig::loadByName('tec_order', 'tec_sales_order', \Drupal\tec_production\Vat::RATE_FIELD)) {
    \Drupal\field\Entity\FieldConfig::create([
      'field_name' => \Drupal\tec_production\Vat::RATE_FIELD,
      'entity_type' => 'tec_order',
      'bundle' => 'tec_sales_order',
      'label' => 'VAT %',
      'description' => 'The rate this sale was raised under, from the customer\'s country. Thailand is the standard rate; anywhere else is 0%.',
      'required' => FALSE,
      'translatable' => TRUE,
      'settings' => [],
    ])->save();
  }

  foreach ([
    'entity_form_display' => 'tec_order.tec_sales_order.default',
    'entity_view_display' => 'tec_order.tec_sales_order.default',
  ] as $type => $id) {
    $display = \Drupal::entityTypeManager()->getStorage($type)->load($id);
    if ($display && $display->getComponent(\Drupal\tec_production\Vat::RATE_FIELD)) {
      $display->removeComponent(\Drupal\tec_production\Vat::RATE_FIELD)->save();
    }
  }
}

/**
 * Writes the factory letterhead into company settings when the keys are missing.
 *
 * Safe to run twice. Called from the update hook and from the settings test,
 * because `drush updatedb` on this host often fails before it reaches 10006.
 * Keys already saved are left alone, so a tax ID typed yesterday is not
 * replaced by the empty default.
 */
function tec_production_ensure_company_identity(): void {
  $config = \Drupal::configFactory()->getEditable(\Drupal\tec_production\Company::CONFIG);
  $changed = FALSE;
  foreach (\Drupal\tec_production\Company::defaults() as $key => $value) {
    if ($config->get($key) !== NULL) {
      continue;
    }
    if ($key === 'address' && is_array($value)) {
      foreach ($value as $part_key => $part) {
        $value[$part_key] = $part === NULL ? '' : (string) $part;
      }
    }
    $config->set($key, $value);
    $changed = TRUE;
  }
  if ($changed) {
    $config->save();
  }
}

/**
 * Stops the order-card "Order status" label inheriting the pill colour.
 *
 * Field Formatter Class put the status words on the whole field wrapper.
 * CSS then painted that wrapper (label included). Safe to run twice.
 */
function tec_production_ensure_status_label_plain(): void {
  $display = \Drupal::entityTypeManager()
    ->getStorage('entity_view_display')
    ->load('tec_order.tec_sales_order.default');
  if (!$display) {
    return;
  }

  $changed = FALSE;
  $token = '[tec_order:field_tec_order_status]';
  foreach ($display->getThirdPartySetting('layout_builder', 'sections') ?? [] as $section) {
    if (!is_object($section) || !method_exists($section, 'getComponents')) {
      continue;
    }
    foreach ($section->getComponents() as $component) {
      if ($component->getPluginId() !== 'field_block:tec_order:tec_sales_order:field_tec_order_status') {
        continue;
      }
      $config = $component->get('configuration');
      if (!is_array($config)) {
        continue;
      }
      $class = (string) ($config['formatter']['third_party_settings']['field_formatter_class']['class'] ?? '');
      if (!str_contains($class, $token)) {
        continue;
      }
      $kept = trim(str_replace($token, '', $class));
      $config['formatter']['third_party_settings']['field_formatter_class']['class'] = $kept === '' ? 'inline-block' : $kept;
      $component->setConfiguration($config);
      $changed = TRUE;
    }
  }

  if ($changed) {
    $display->save();
  }
}

