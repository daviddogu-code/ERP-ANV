<?php

/**
 * @file
 * Admin form styling helpers (inventory stock modal, etc.).
 */

use Drupal\Component\Utility\NestedArray;
use Drupal\Core\Entity\EntityFormInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Link;
use Drupal\Core\Render\Element;
use Drupal\Core\Url;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\taxonomy\TermInterface;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_entity_view().
 */
function admin_form_styles_entity_view(array &$build, $entity, $display, $view_mode) {
  if ($entity->getEntityTypeId() === 'tec_product' && $entity->bundle() === 'tec_product') {
    $build['#attached']['library'][] = 'admin_form_styles/product-view';
  }
}

/**
 * Implements hook_views_pre_render().
 *
 * Narrows the price box of the brand's catalogue, which arrives as wide as the
 * column it sits in. Nothing else about that table is styled: the rest of it is
 * drawn the way the theme draws every other table here.
 *
 * Attached from here rather than from a stylesheet injected by path, because the
 * display is embedded in the brand's term page and could be embedded elsewhere
 * tomorrow. It travels with the display, not with the address.
 */
function admin_form_styles_views_pre_render(ViewExecutable $view): void {
  if ($view->id() === 'tec_products' && $view->current_display === 'brand_catalogue') {
    $view->element['#attached']['library'][] = 'admin_form_styles/brand-catalogue';
  }
}

/**
 * Implements hook_library_info_alter().
 *
 * Completes the popup module's own stylesheet with the hover rule its javascript
 * fails to deliver. See css/popup-on-hover.css for why the script fails.
 *
 * It goes in that library rather than in one of ours, attached from somewhere,
 * because the module hangs its library on every page and the field appears in
 * seventeen displays across eight views. Anywhere the popup can be drawn, its
 * stylesheet is already there; this way the rule cannot end up somewhere the
 * markup is not, or missing from somewhere it is.
 */
function admin_form_styles_library_info_alter(array &$libraries, string $extension): void {
  if ($extension === 'simple_popup_views' && isset($libraries['simple_popup_views'])) {
    $libraries['simple_popup_views']['css']['theme']['/modules/custom/admin_form_styles/css/popup-on-hover.css'] = [];
  }
}

/**
 * Implements hook_page_attachments().
 */
function admin_form_styles_page_attachments(array &$attachments) {
  $route_match = \Drupal::routeMatch();

  // SAFETY CHECK - prevent 500 errors
  if (!$route_match) {
    return;
  }

  $route_name = $route_match->getRouteName();

  // Additional safety check for route name
  if (!$route_name) {
    return;
  }

  $current_path = \Drupal::service('path.current')->getPath();
  $request = \Drupal::request();

  // The purchase draft used to load a second calculator here, on top of the one
  // in asset_injector.js.draft_for_ace_company_view. Both wrote the same cells,
  // so while they agreed nobody noticed. They stopped agreeing the day the draft
  // swapped its cost column for the line's own price: this one still looked for
  // td.views-field-field-tec-cost, found nothing, multiplied by zero and wrote
  // "฿ 0.00" over a subtotal that the other one had just got right.
  //
  // Nothing was added back in its place. The injected script already totals the
  // rows and draws the foot, and it does it for the sales draft too.

  // Load on taxonomy add/edit forms (original functionality)
  if (strpos($route_name, 'entity.taxonomy_term.add_form') !== FALSE ||
      strpos($route_name, 'entity.taxonomy_term.edit_form') !== FALSE) {
    $attachments['#attached']['library'][] = 'admin_form_styles/form-styles';
  }

  // ONLY load on inventory transaction forms - be more specific
  if (strpos($current_path, '/admin/content/tec_inventory/add/tec_inventory_transaction') !== FALSE) {
    $attachments['#attached']['library'][] = 'admin_form_styles/form-styles';
  }

  // Force load ONLY on inventory modal wrapper format requests
  if ($request->query->get('_wrapper_format') === 'drupal_modal' &&
      strpos($current_path, 'tec_inventory_transaction') !== FALSE) {
    $attachments['#attached']['library'][] = 'admin_form_styles/form-styles';
  }
}

/**
 * Implements hook_form_alter().
 */
function admin_form_styles_form_alter(&$form, $form_state, $form_id) {
  // Attach calculator library to main inventory form
  if ($form_id === 'taxonomy_term_tec_inventory_form') {
    $form['#attached']['library'][] = 'admin_form_styles/inventory-calculator';
    _admin_form_styles_fix_decimal_steps($form, 'taxonomy_term');
    // Units are managed in taxonomy (no inline create on UoM selects).
    _admin_form_styles_attach_taxonomy_manage_link(
      $form,
      'field_tec_unit_purchase',
      'tec_units',
      t('Manage units')
    );
    _admin_form_styles_attach_taxonomy_manage_link(
      $form,
      'field_tec_material_type',
      'tec_materials',
      t('Manage Material Types')
    );

    // Replace generic Drupal "Add term" / "Edit term" titles.
    $entity = NULL;
    if (method_exists($form_state, 'getFormObject') && method_exists($form_state->getFormObject(), 'getEntity')) {
      $entity = $form_state->getFormObject()->getEntity();
    }
    if ($entity instanceof TermInterface && $entity->bundle() === 'tec_inventory') {
      $form['#title'] = $entity->isNew()
        ? t('Add New Material')
        : t('Edit Material');
    }
  }

  // Product, color and size catalogs are managed in taxonomy (no inline create),
  // so each of those forms carries a link to its catalog.
  //
  // These used to be matched by form id — 'tec_product_tec_product_form' and
  // friends — and that silently failed on every edit screen. The edit route uses
  // the 'edit' form operation and Drupal appends the operation to the id, so the
  // real id there is 'tec_product_tec_product_edit_form'. The links only ever
  // showed while creating. Matching on the entity is immune to the operation.
  _admin_form_styles_attach_catalog_links(
    $form,
    _admin_form_styles_form_entity($form_state)
  );
  _admin_form_styles_attach_vat_rate_link(
    $form,
    _admin_form_styles_form_entity($form_state)
  );
  _admin_form_styles_hide_unused_brand_form_parts(
    $form,
    _admin_form_styles_form_entity($form_state)
  );

  // Material Types overview: editable "Show on production document" checkboxes.
  if ($form_id === 'taxonomy_overview_terms') {
    _admin_form_styles_tec_materials_overview_checkboxes($form, $form_state);
  }

  // Tables you can type into: the widget in each cell repeats the column header.
  if (str_starts_with($form_id, 'views_form_')) {
    _admin_form_styles_hide_views_widget_titles($form, $form_state);
  }

  // After deleting a size/color, return to the parent product (not /p or ECK list).
  // Use #after_build so our submit runs after ECA appends HookHandler::submit.
  if (in_array($form_id, [
    'tec_product_tec_size_variation_delete_form',
    'tec_product_tec_color_variation_delete_form',
  ], TRUE)) {
    $form['#after_build'][] = 'admin_form_styles_tec_product_delete_after_build';
  }

  // ONLY target the inventory transaction form - be very specific
  if ($form_id === 'tec_inventory_tec_inventory_transaction_form') {
    $form['#attached']['library'][] = 'admin_form_styles/form-styles';

    // Decimal storage scale is 4 → browser spinner would step 0.0001.
    // Step by whole units for the wheel; fractional values can still be typed
    // if the browser allows (HTML5 may warn on non-integers with step=1).
    if (isset($form['field_tec_quantity']['widget'][0]['value'])) {
      $form['field_tec_quantity']['widget'][0]['value']['#step'] = '1';
    }

    $material = _admin_form_styles_resolve_transaction_material($form_state);
    $uom_label = _admin_form_styles_material_inventory_uom_label($material);
    $material_name = $material instanceof TermInterface ? $material->label() : '';

    // Replace generic "units" suffix with Inventory UoM (e.g. Sheet, kg).
    if (isset($form['field_tec_quantity']['widget'][0]['value'])) {
      $form['field_tec_quantity']['widget'][0]['value']['#field_suffix'] = $uom_label;
    }

    // Operative title for full page + modal dialog.
    $title = $material_name !== ''
      ? t('Adjust stock: @name', ['@name' => $material_name])
      : t('Adjust stock');
    $form['#title'] = $title;

    $current_stock = \Drupal::request()->query->get('current_stock');
    $form['#attached']['drupalSettings']['adminFormStyles']['stockDisplay'] = [
      'uom' => $uom_label,
      'title' => (string) $title,
      'materialName' => $material_name,
      'currentStock' => is_numeric($current_stock) ? (float) $current_stock : NULL,
    ];
  }
}

/**
 * Implements hook_inline_entity_form_entity_form_alter().
 *
 * Colors and sizes are almost never edited on their own page: they are worked on
 * embedded inside the product form, and an embedded form does not go through
 * hook_form_alter() with its own form id — the parent's id is the only one that
 * fires. So without this hook the catalog links can never show up where the work
 * actually happens, no matter how well the form ids are matched.
 *
 * Sizes reach it through "Add new size" / "Edit" on the sizes table, which is
 * exactly the moment someone notices a size is missing from the catalog.
 */
function admin_form_styles_inline_entity_form_entity_form_alter(array &$entity_form, FormStateInterface &$form_state) {
  _admin_form_styles_attach_catalog_links(
    $entity_form,
    $entity_form['#entity'] ?? NULL
  );
  // Harmless on a form without decimal boxes, and the alternative is finding
  // out the hard way the day a material is added from inside something else.
  $embedded = $entity_form['#entity'] ?? NULL;
  if ($embedded instanceof EntityInterface) {
    _admin_form_styles_fix_decimal_steps($entity_form, $embedded->getEntityTypeId());
  }
}

/**
 * Costs and factors the server works out again on every save.
 *
 * Whatever the browser leaves in these boxes is discarded and divided out of
 * the purchase cost by `tec_inventory_taxonomy_term_presave()`, so there is
 * nothing in them worth checking. Everything else on the form is typed by hand
 * and does get checked.
 */
const ADMIN_FORM_STYLES_DERIVED_COSTS = ['field_tec_price_uos', 'field_tec_price'];

/**
 * Replace Drupal's step check on decimal boxes with one that is exact.
 *
 * Drupal validates a decimal box against a step it derives from the column's
 * scale — five decimals, a step of 0.00001 — and `Number::validStep()` gets
 * that wrong for large numbers. It measures the leftover of dividing the value
 * by the step in floating point, and compares it against a fixed margin of
 * `step / 2^24`. The leftover grows with the size of the value while the margin
 * does not, so past a certain figure nothing passes, however round.
 *
 * That ceiling works out at about 10^(9 - decimals): a thousand at six
 * decimals, ten thousand at five, a hundred thousand at four. It refused a
 * consumption cost of 799.70 and an inventory-to-consumption factor of 10000,
 * both with *"is not a valid number"*, which was true of neither.
 *
 * The ceiling is invisible until someone meets it, and it moves whenever a
 * scale changes. Raising the two conversion factors from two decimals to five
 * dropped theirs from ten million to ten thousand and locked, without touching
 * them, every material already holding a bigger factor — the value was in the
 * database and the form revalidates it on every save.
 *
 * So the step goes to 'any' and the rule it was meant to enforce is checked
 * properly instead, by counting the digits after the dot in the text that was
 * typed. That is the same rule — a decimal is a multiple of its step exactly
 * when it fits the scale — decided on the characters rather than on a division
 * that cannot represent them.
 *
 * @param array $form
 *   The form, or an embedded entity form.
 * @param string $entity_type
 *   Entity type whose field storage says how many decimals each box holds.
 */
function _admin_form_styles_fix_decimal_steps(array &$form, string $entity_type): void {
  foreach (Element::children($form) as $field_name) {
    // Checked before the reference is taken: referencing a key that is not
    // there would create it, and every non-field child of the form would come
    // out of this loop carrying an empty widget.
    $type = $form[$field_name]['widget'][0]['value']['#type'] ?? NULL;
    if ($type !== 'number') {
      continue;
    }

    $storage = FieldStorageConfig::loadByName($entity_type, $field_name);
    if (!$storage || $storage->getType() !== 'decimal') {
      continue;
    }

    $scale = (int) $storage->getSetting('scale');
    $element = &$form[$field_name]['widget'][0]['value'];
    $element['#step'] = 'any';

    // The calculator worked out how many decimals to print by reading the step.
    // With no step to read it would print the raw division — 266.66666666666663
    // — so it is told the scale instead.
    $element['#attributes']['data-tec-decimals'] = $scale;

    if (!in_array($field_name, ADMIN_FORM_STYLES_DERIVED_COSTS, TRUE)) {
      $element['#tec_scale'] = $scale;
      $element['#element_validate'][] = '_admin_form_styles_check_decimals';
    }
    unset($element);
  }
}

/**
 * Refuse a typed decimal that does not fit its column, counting characters.
 *
 * This is what `Number::validStep()` was there for. Without it the extra
 * decimals would reach a column that cannot hold them and be rounded away in
 * silence on the way in.
 */
function _admin_form_styles_check_decimals(array &$element, FormStateInterface $form_state): void {
  $value = $element['#value'] ?? '';
  if ($value === '' || $value === NULL || !is_numeric($value)) {
    return;
  }

  // Exponent form has no digits after a dot to count. It reaches the column
  // rounded either way, and nobody types it into a spinner.
  $typed = (string) $value;
  if (stripos($typed, 'e') !== FALSE) {
    return;
  }

  $dot = strpos($typed, '.');
  $decimals = $dot === FALSE ? 0 : strlen(rtrim(substr($typed, $dot + 1), '0'));
  $scale = (int) ($element['#tec_scale'] ?? 0);
  if ($decimals <= $scale) {
    return;
  }

  $form_state->setError($element, t('%name holds at most @scale decimals.', [
    '%name' => $element['#title'] ?? end($element['#parents']),
    '@scale' => $scale,
  ]));
}

/**
 * Attach whichever catalog links belong to the entity being edited.
 *
 * @param array $form
 *   The form, or the embedded entity form.
 * @param mixed $entity
 *   The entity being edited, if there is one.
 */
function _admin_form_styles_attach_catalog_links(array &$form, $entity) {
  if (!$entity instanceof EntityInterface) {
    return;
  }

  // Field that holds the catalog value, the vocabulary behind it, and the link
  // text, per kind of entity. The material form has its own two links attached
  // above, together with the calculator library it also needs.
  $catalogs = [
    'tec_product:tec_product' => [
      ['field_tec_product_type', 'tec_product_types', t('Manage product types')],
      ['field_tec_brand', 'tec_brands', t('Manage brands')],
    ],
    'tec_product:tec_color_variation' => [
      ['field_tec_colors', 'tec_colors', t('Manage colors')],
    ],
    'tec_product:tec_size_variation' => [
      ['field_tec_size', 'tec_sizes', t('Manage sizes')],
    ],
  ];

  $key = $entity->getEntityTypeId() . ':' . $entity->bundle();
  foreach ($catalogs[$key] ?? [] as [$field_name, $vocabulary, $link_text]) {
    _admin_form_styles_attach_taxonomy_manage_link($form, $field_name, $vocabulary, $link_text);
  }
}

/**
 * Put the company's VAT rate beside the field asking whether it is charged.
 *
 * Somebody standing on VAT treatment has just decided that this supplier
 * charges, and the next thing they want to know is how much. That is one number
 * for the whole company and it lives in the company settings, so the door goes
 * here, where the question comes up, rather than only in a menu.
 *
 * The rate is read live rather than written into the text, so this cannot end
 * up advertising a figure the company stopped using.
 */
function _admin_form_styles_attach_vat_rate_link(array &$form, $entity): void {
  if (!$entity instanceof EntityInterface || $entity->getEntityTypeId() !== 'tec_crm') {
    return;
  }
  // Asked rather than assumed: this module styles forms and should not stop
  // working because the module that owns VAT is switched off.
  if (!\Drupal::moduleHandler()->moduleExists('tec_production')) {
    return;
  }

  $rate = \Drupal\tec_production\Vat::standardRate();
  // 7 rather than 7.00, and 7.5 rather than 7.50.
  $shown = rtrim(rtrim(number_format($rate, 2, '.', ''), '0'), '.');

  try {
    $url = Url::fromRoute('tec_production.company_settings');
  }
  catch (\Exception $e) {
    return;
  }

  _admin_form_styles_attach_field_link(
    $form,
    \Drupal\tec_production\Vat::TREATMENT_FIELD,
    $url,
    t('VAT is currently @rate% — change it', ['@rate' => $shown])
  );
}

/**
 * Take the three blocks nobody answers out of the brand form.
 *
 * Relations, Weight and Revision information come free with every taxonomy form
 * and none of the three does anything here. No vocabulary in this ERP uses
 * hierarchy, so there is no parent to pick. The brands screen has no sort at all
 * -`sorts: {}` in views.view.tec_brands- so the weight orders nothing; the place
 * to order terms is the vocabulary overview, which writes that same weight by
 * dragging and does not need the box. And `new_revision` is off in every
 * vocabulary, so the log message is written onto a revision that never happens.
 *
 * Weight is a required box, and a required box that nobody can reach would
 * normally block the form. It does not, because Drupal takes the value of an
 * unreachable element from its default, and the default is the weight the term
 * already has.
 *
 * Brands only, on purpose. The same three are just as useless on colors, sizes
 * and materials, but hiding something everywhere is a different decision from
 * hiding it where it was asked for.
 *
 * @param array $form
 *   The form.
 * @param mixed $entity
 *   The entity being edited, if there is one.
 */
function _admin_form_styles_hide_unused_brand_form_parts(array &$form, $entity): void {
  if (!$entity instanceof TermInterface || $entity->bundle() !== 'tec_brands') {
    return;
  }

  // The log message is a field of its own that Drupal only moves into the
  // Revision information group, so hiding the group would leave it behind.
  foreach (['relations', 'revision_information', 'revision', 'revision_log_message'] as $key) {
    if (isset($form[$key])) {
      $form[$key]['#access'] = FALSE;
    }
  }
}

/**
 * Do what "hide the widget title" already promised in a views table.
 *
 * When a column of a view is an editable field, the widget brings its own label
 * along, so every row of the table repeats the header: a column called Quantity
 * with the word Quantity printed in each cell, and the same with Sales price.
 *
 * views_entity_form_field has a "Hide field title" box for exactly this and it
 * is ticked on all three of the tables this ERP lets people type into. It works
 * by adding a class the module's own stylesheet hides -- but only on the branch
 * where the widget is not wrapped in a container. A plain number widget is
 * wrapped in one, and on that branch the module only knows how to unpick a date
 * field, so the number fields keep their label and the box does nothing. It has
 * been like that on /o/draft and /po/draft since they were built.
 *
 * So the box is honoured here, and only where it is actually ticked: the handler
 * is asked, rather than assumed. Made invisible rather than removed, because a
 * screen reader still needs to say which figure the cursor is in when the header
 * is three rows up.
 */
function _admin_form_styles_hide_views_widget_titles(array &$form, FormStateInterface $form_state): void {
  // La vista no esta en el estado del formulario, aunque uno lo daria por hecho:
  // Views la pasa como argumento de construccion, asi que se busca entre ellos.
  $view = NULL;
  foreach ($form_state->getBuildInfo()['args'] ?? [] as $argumento) {
    if ($argumento instanceof ViewExecutable) {
      $view = $argumento;
      break;
    }
  }
  if (!$view || !isset($view->field) || !is_array($view->field)) {
    return;
  }

  foreach ($view->field as $id => $handler) {
    if (!isset($form[$id]) || !is_array($form[$id])) {
      continue;
    }
    if (empty($handler->options['plugin']['hide_title'])) {
      continue;
    }
    foreach (Element::children($form[$id]) as $row) {
      foreach (Element::children($form[$id][$row]) as $field_name) {
        if (!isset($form[$id][$row][$field_name]['widget'])) {
          continue;
        }
        _admin_form_styles_blank_widget_title($form[$id][$row][$field_name]['widget']);
      }
    }
  }
}

/**
 * Make a widget's own label invisible, wherever that widget keeps it.
 *
 * The label sits in a different place depending on the kind of field -- a
 * number keeps it in [0]['value'], a checkbox in ['value'], a reference in
 * ['target_id'] -- so all of them are checked rather than guessing at one.
 */
function _admin_form_styles_blank_widget_title(array &$widget): void {
  if (isset($widget['#title'])) {
    $widget['#title_display'] = 'invisible';
  }

  // Read with NestedArray and not with a reference of our own: referencing a key
  // that is not there would create it, and every widget coming out of here would
  // have grown an empty child.
  foreach ([['value'], ['target_id'], [0, 'value'], [0, 'target_id']] as $donde) {
    $elemento = &NestedArray::getValue($widget, $donde, $existe);
    if ($existe && is_array($elemento) && isset($elemento['#title'])) {
      $elemento['#title_display'] = 'invisible';
    }
    unset($elemento);
  }
}

/**
 * The entity a form is editing, if it is an entity form at all.
 */
function _admin_form_styles_form_entity(FormStateInterface $form_state) {
  $form_object = $form_state->getFormObject();

  return $form_object instanceof EntityFormInterface ? $form_object->getEntity() : NULL;
}

/**
 * Attach a manage-catalog link under a form field.
 *
 * @param array $form
 *   The form array.
 * @param string $field_name
 *   Field machine name.
 * @param string $vocabulary
 *   Taxonomy vocabulary ID.
 * @param \Drupal\Core\StringTranslation\TranslatableMarkup|string $link_text
 *   Link label.
 */
function _admin_form_styles_attach_taxonomy_manage_link(array &$form, $field_name, $vocabulary, $link_text) {
  $account = \Drupal::currentUser();
  if (
    !$account->hasPermission('administer taxonomy')
    && !$account->hasPermission("create terms in $vocabulary")
    && !$account->hasPermission("edit terms in $vocabulary")
  ) {
    return;
  }

  try {
    $url = Url::fromRoute('entity.taxonomy_vocabulary.overview_form', [
      'taxonomy_vocabulary' => $vocabulary,
    ]);
  }
  catch (\Exception $e) {
    return;
  }

  _admin_form_styles_attach_field_link($form, $field_name, $url, $link_text);
}

/**
 * Attach a link under a form field, pointing anywhere.
 *
 * Split out of the catalog link above, which could only ever point at a
 * taxonomy overview. That covered the four catalogs and nothing else, and the
 * first field that needed a door somewhere other than a vocabulary — VAT
 * treatment, whose question is answered by the company's rate and not by a list
 * of terms — had nowhere to hang it.
 *
 * The link is dropped silently if the destination is one this user cannot
 * reach. A door that opens onto "access denied" is worse than no door.
 *
 * @param array $form
 *   The form, or the embedded entity form.
 * @param string $field_name
 *   Field machine name.
 * @param \Drupal\Core\Url $url
 *   Where the link goes.
 * @param \Drupal\Core\StringTranslation\TranslatableMarkup|string $link_text
 *   Link label.
 */
function _admin_form_styles_attach_field_link(array &$form, string $field_name, Url $url, $link_text): void {
  if (!isset($form[$field_name]) || !$url->access()) {
    return;
  }

  $link = Link::fromTextAndUrl($link_text, $url)->toString();
  $markup = '<div class="description admin-form-styles-catalog-link">' . $link . '</div>';

  if (!isset($form[$field_name]['widget']['#suffix'])) {
    $form[$field_name]['widget']['#suffix'] = '';
  }
  // Two callers can reach the same field now — hook_form_alter() and the inline
  // form hook — and appending blindly would print the link twice.
  if (str_contains($form[$field_name]['widget']['#suffix'], $markup)) {
    return;
  }
  $form[$field_name]['widget']['#suffix'] .= $markup;
}

/**
 * Add production-doc checkboxes on Material Types taxonomy overview.
 */
function _admin_form_styles_tec_materials_overview_checkboxes(array &$form, FormStateInterface $form_state) {
  $vocabulary = $form_state->get(['taxonomy', 'vocabulary']);
  if (!$vocabulary || $vocabulary->id() !== 'tec_materials' || empty($form['terms']['#header'])) {
    return;
  }

  $header = [];
  foreach ($form['terms']['#header'] as $key => $label) {
    $header[$key] = $label;
    if ($key === 'term') {
      $header['production_doc'] = t('Show in Production Documents');
    }
  }
  $form['terms']['#header'] = $header;

  foreach (Element::children($form['terms']) as $key) {
    if (empty($form['terms'][$key]['#term']) || !($form['terms'][$key]['#term'] instanceof TermInterface)) {
      continue;
    }
    /** @var \Drupal\taxonomy\TermInterface $term */
    $term = $form['terms'][$key]['#term'];
    $checked = FALSE;
    if ($term->hasField('field_tec_show_on_prod_doc') && !$term->get('field_tec_show_on_prod_doc')->isEmpty()) {
      $checked = (bool) $term->get('field_tec_show_on_prod_doc')->value;
    }

    $row = $form['terms'][$key];
    $new_row = [
      '#term' => $row['#term'],
      '#attributes' => $row['#attributes'] ?? [],
      'term' => $row['term'],
      'production_doc' => [
        '#type' => 'checkbox',
        '#title' => t('Show in Production Documents'),
        '#title_display' => 'invisible',
        '#default_value' => $checked,
      ],
      'status' => $row['status'],
      'operations' => $row['operations'],
    ];
    if (array_key_exists('weight', $row)) {
      $new_row['weight'] = $row['weight'];
    }
    $form['terms'][$key] = $new_row;
  }

  $form['actions']['submit']['#submit'][] = 'admin_form_styles_tec_materials_overview_submit';
}

/**
 * Save production-doc flags from Material Types overview.
 */
function admin_form_styles_tec_materials_overview_submit(array &$form, FormStateInterface $form_state) {
  $terms = $form_state->getValue('terms');
  if (!is_array($terms)) {
    return;
  }

  foreach ($terms as $key => $row) {
    if (!isset($form['terms'][$key]['#term']) || !($form['terms'][$key]['#term'] instanceof TermInterface)) {
      continue;
    }
    if (!array_key_exists('production_doc', $row)) {
      continue;
    }
    /** @var \Drupal\taxonomy\TermInterface $term */
    $term = $form['terms'][$key]['#term'];
    if (!$term->hasField('field_tec_show_on_prod_doc')) {
      continue;
    }
    $new = !empty($row['production_doc']) ? 1 : 0;
    $old = $term->get('field_tec_show_on_prod_doc')->isEmpty()
      ? 0
      : (int) $term->get('field_tec_show_on_prod_doc')->value;
    if ($old !== $new) {
      $term->set('field_tec_show_on_prod_doc', $new);
      $term->save();
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for page_title.
 */
function admin_form_styles_preprocess_page_title(&$variables) {
  $path = \Drupal::service('path.current')->getPath();
  $route_match = \Drupal::routeMatch();

  if (strpos($path, '/admin/content/tec_inventory/add/tec_inventory_transaction') !== FALSE) {
    $material = _admin_form_styles_resolve_transaction_material();
    if ($material instanceof TermInterface) {
      $variables['title'] = t('Adjust stock: @name', ['@name' => $material->label()]);
    }
    else {
      $variables['title'] = t('Adjust stock');
    }
    return;
  }

  // Material add/edit uses taxonomy term routes with a generic "term" title.
  $route_name = $route_match ? $route_match->getRouteName() : '';
  if ($route_name === 'entity.taxonomy_term.add_form') {
    $vocabulary = $route_match->getParameter('taxonomy_vocabulary');
    $vid = is_object($vocabulary) && method_exists($vocabulary, 'id') ? $vocabulary->id() : $vocabulary;
    if ($vid === 'tec_inventory') {
      $variables['title'] = t('Add New Material');
    }
  }
  elseif ($route_name === 'entity.taxonomy_term.edit_form') {
    $term = $route_match->getParameter('taxonomy_term');
    if ($term instanceof TermInterface && $term->bundle() === 'tec_inventory') {
      $variables['title'] = t('Edit Material');
    }
  }
}

/**
 * Resolve the material term for the inventory transaction form.
 *
 * @param \Drupal\Core\Form\FormStateInterface|null $form_state
 *   Optional form state when altering the form.
 *
 * @return \Drupal\taxonomy\TermInterface|null
 *   The material term, or NULL.
 */
function _admin_form_styles_resolve_transaction_material($form_state = NULL) {
  if ($form_state && method_exists($form_state, 'getFormObject')) {
    $form_object = $form_state->getFormObject();
    if (method_exists($form_object, 'getEntity')) {
      $entity = $form_object->getEntity();
      if ($entity && $entity->hasField('field_tec_inventory') && !$entity->get('field_tec_inventory')->isEmpty()) {
        $material = $entity->get('field_tec_inventory')->entity;
        if ($material instanceof TermInterface) {
          return $material;
        }
      }
    }
  }

  $query = \Drupal::request()->query->all();
  $tid = $query['edit']['field_tec_inventory']['widget'][0]['target_id'] ?? NULL;
  if (!$tid || !is_numeric($tid)) {
    return NULL;
  }

  $term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load($tid);
  return $term instanceof TermInterface ? $term : NULL;
}

/**
 * After-build: ensure delete redirect submit runs last (after ECA).
 */
function admin_form_styles_tec_product_delete_after_build(array $form, FormStateInterface $form_state): array {
  $handler = 'admin_form_styles_tec_product_delete_redirect_submit';
  _admin_form_styles_append_submit_last($form, $handler);
  if (isset($form['actions']['submit']) && is_array($form['actions']['submit'])) {
    _admin_form_styles_append_submit_last($form['actions']['submit'], $handler);
  }
  return $form;
}

/**
 * Append a submit callback as the last handler on an element.
 *
 * @param array $element
 *   Form or button element (by reference).
 * @param string $handler
 *   Submit callback name.
 */
function _admin_form_styles_append_submit_last(array &$element, string $handler): void {
  $submits = [];
  foreach ($element['#submit'] ?? [] as $callback) {
    if ($callback !== $handler) {
      $submits[] = $callback;
    }
  }
  $submits[] = $handler;
  $element['#submit'] = $submits;
}

/**
 * Submit handler: redirect size/color delete to the parent product.
 */
function admin_form_styles_tec_product_delete_redirect_submit(array &$form, FormStateInterface $form_state) {
  $form_object = $form_state->getFormObject();
  if (!method_exists($form_object, 'getEntity')) {
    return;
  }
  $entity = $form_object->getEntity();
  if (!$entity instanceof EntityInterface) {
    return;
  }

  $url = _admin_form_styles_tec_product_post_delete_url($entity);
  if (!$url instanceof Url) {
    return;
  }

  // Prefer parent product over ?destination= (often lost or points at /p).
  \Drupal::request()->query->remove('destination');
  if (\Drupal::hasService('redirect_response_subscriber')) {
    \Drupal::service('redirect_response_subscriber')->setIgnoreDestination(TRUE);
  }
  $form_state->setRedirectUrl($url);
}

/**
 * Build canonical product URL after deleting a size or color variation.
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   The size or color entity being deleted.
 *
 * @return \Drupal\Core\Url|null
 *   Product view URL with optional color fragment, or NULL.
 */
function _admin_form_styles_tec_product_post_delete_url(EntityInterface $entity) {
  if ($entity->getEntityTypeId() !== 'tec_product') {
    return NULL;
  }

  $bundle = $entity->bundle();
  if (!in_array($bundle, ['tec_size_variation', 'tec_color_variation'], TRUE)) {
    return NULL;
  }

  if (!$entity->hasField('field_tec_product') || $entity->get('field_tec_product')->isEmpty()) {
    return NULL;
  }

  $product_id = (int) $entity->get('field_tec_product')->target_id;
  if ($product_id < 1) {
    return NULL;
  }

  $options = [];
  if ($bundle === 'tec_size_variation' && $entity->hasField('field_tec_color_variation') && !$entity->get('field_tec_color_variation')->isEmpty()) {
    $options['fragment'] = (string) $entity->get('field_tec_color_variation')->target_id;
  }
  elseif ($bundle === 'tec_color_variation') {
    $options['fragment'] = (string) $entity->id();
  }

  return Url::fromRoute('entity.tec_product.canonical', ['tec_product' => $product_id], $options);
}

/**
 * Inventory UoM label for a material, fallback "units".
 *
 * @param \Drupal\taxonomy\TermInterface|null $material
 *   The material term.
 *
 * @return string
 *   UoM name.
 */
function _admin_form_styles_material_inventory_uom_label($material) {
  if (!$material instanceof TermInterface || !$material->hasField('field_tec_uos')) {
    return (string) t('units');
  }
  if ($material->get('field_tec_uos')->isEmpty()) {
    return (string) t('units');
  }
  $uos = $material->get('field_tec_uos')->entity;
  if ($uos instanceof TermInterface && $uos->label()) {
    return $uos->label();
  }
  return (string) t('units');
}
