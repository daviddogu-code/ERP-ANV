{#
/**
 * Printed sales proforma. Same table as /o/order.
 */
#}
<article class="tec-proforma">
  <header class="tec-proforma__head">
    <div class="tec-proforma__meta">
      <table class="tec-proforma__meta-table">
        <tr>
          <th>{{ 'PROFORMA'|t }}</th>
          <td>{{ order_number }}</td>
        </tr>
        <tr>
          <th>{{ 'Date'|t }}</th>
          <td>{{ date }}</td>
        </tr>
      </table>
      <div class="tec-proforma__buyer">
        <table class="tec-proforma__buyer-table">
          <tr>
            <th>{{ 'Company'|t }}</th>
            <td>{{ buyer_name }}</td>
          </tr>
          {% if buyer_tax_id %}
            <tr>
              <th>{{ 'VAT ID'|t }}</th>
              <td>{{ buyer_tax_id }}</td>
            </tr>
          {% endif %}
          {% if buyer_country %}
            <tr>
              <th>{{ 'Country'|t }}</th>
              <td>{{ buyer_country }}</td>
            </tr>
          {% endif %}
          {% if buyer_lines %}
            <tr>
              <th>{{ 'Address'|t }}</th>
              <td>{% for line in buyer_lines %}{{ line }}{% if not loop.last %}<br />{% endif %}{% endfor %}</td>
            </tr>
          {% endif %}
        </table>
      </div>
    </div>
    <div class="tec-proforma__seller">
      <table class="tec-proforma__seller-table">
        <tr>
          <th>{{ 'Company'|t }}</th>
          <td class="tec-proforma__legal">{{ seller_name }}</td>
        </tr>
        {% if seller_tax_id %}
          <tr>
            <th>{{ 'Tax ID'|t }}</th>
            <td>{{ seller_tax_id }}</td>
          </tr>
        {% endif %}
        {% if seller_country %}
          <tr>
            <th>{{ 'Country'|t }}</th>
            <td>{{ seller_country }}</td>
          </tr>
        {% endif %}
        {% if seller_lines %}
          <tr>
            <th>{{ 'Address'|t }}</th>
            <td>{% for line in seller_lines %}{{ line }}{% if not loop.last %}<br />{% endif %}{% endfor %}</td>
          </tr>
        {% endif %}
        {% if seller_email %}
          <tr>
            <th>{{ 'Email'|t }}</th>
            <td>{{ seller_email }}</td>
          </tr>
        {% endif %}
        {% if seller_phone %}
          <tr>
            <th>{{ 'Phone'|t }}</th>
            <td>{{ seller_phone }}</td>
          </tr>
        {% endif %}
      </table>
    </div>
  </header>

  <div class="tec-portal tec-portal--place tec-portal--proforma">
    {{ lines }}
  </div>

  {% if bank %}
    <section class="tec-proforma__bank">
      <h2>{{ 'Bank details'|t }}</h2>
      <table class="tec-proforma__bank-table">
        {% if bank.name %}
          <tr><th>{{ 'Bank'|t }}</th><td>{{ bank.name }}</td></tr>
        {% endif %}
        {% if bank.holder %}
          <tr><th>{{ 'Account holder'|t }}</th><td>{{ bank.holder }}</td></tr>
        {% endif %}
        {% if bank.account %}
          <tr><th>{{ 'Account number'|t }}</th><td>{{ bank.account }}</td></tr>
        {% endif %}
        {% if bank.swift %}
          <tr><th>{{ 'SWIFT / BIC'|t }}</th><td>{{ bank.swift }}</td></tr>
        {% endif %}
      </table>
    </section>
  {% endif %}
</article>
