/**
 * Implements hook_preprocess_HOOK() for html.
 */
function tec_portal_preprocess_html(array &$variables) {
  $route = \Drupal::routeMatch()->getRouteName();
  if ($route === 'tec_portal.proforma') {
    \Drupal::messenger()->deleteAll();
    $variables['attributes']['class'][] = 'tec-proforma-print';
    $order = \Drupal::routeMatch()->getParameter('tec_order');
    $variables['head_title'] = ['title' => Proforma::fileTitle($order)];
    return;
  }
  if ($route === 'tec_portal.shipment_packing' || $route === 'tec_portal.shipment_invoice') {
    \Drupal::messenger()->deleteAll();
    $variables['attributes']['class'][] = 'tec-proforma-print';
    $shipment = \Drupal::routeMatch()->getParameter('tec_shipment');
    $kind = $route === 'tec_portal.shipment_invoice' ? 'invoice' : 'packing';
    $variables['head_title'] = ['title' => Shipment::fileTitle($shipment, $kind)];
    return;
  }
  if ($route === 'tec_portal.invoice_print') {
    \Drupal::messenger()->deleteAll();
    $variables['attributes']['class'][] = 'tec-proforma-print';
    $number = \Drupal::routeMatch()->getParameter('number');
    $invoice = \Drupal\tec_portal\Controller\InvoicePrintController::loadIssued($number);
    $variables['head_title'] = ['title' => TaxInvoice::fileTitle($invoice)];
  }
}
