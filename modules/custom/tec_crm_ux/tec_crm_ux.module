<?php

/**
 * @file
 * Usability fixes for the CRM contact forms.
 */

use CommerceGuys\Addressing\AddressFormat\FieldOverrides;
use Drupal\address\FieldHelper;
use Drupal\Component\Utility\NestedArray;
use Drupal\Core\Access\AccessResult;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityFormInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\FieldableEntityInterface;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Field\FieldStorageDefinitionInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Url;
use Drupal\views\ViewExecutable;
use Drupal\views\Views;

/**
 * Contact type taxonomy term IDs.
 */
const TEC_CRM_UX_TYPE_CUSTOMER = 1395;
const TEC_CRM_UX_TYPE_SUPPLIER = 1396;

/**
 * Field types a URL is allowed to prefill.
 */
const TEC_CRM_UX_PREFILL_TYPES = [
  'boolean',
  'entity_reference',
  'list_float',
  'list_integer',
  'list_string',
];

/**
 * Purchase / supplier fields shown only when Contact type = Supplier.
 *
 * The short code used to be in here as field_tec_supplier_code. It left on
 * 16 August 2026: the same company can be customer and supplier at once, so
 * there is now one code per contact (field_tec_customer_code) sitting in the
 * general block, where it is always visible. Hiding it behind the Supplier
 * checkbox would hide it from half the orders that use it.
 */
function tec_crm_ux_supplier_field_names(): array {
  return [
    'field_tec_purchase_currency',
    'field_tec_incoterm',
    'field_tec_payment_terms',
    'field_tec_vat_treatment',
    'field_tec_website',
    'field_tec_supplier_active',
  ];
}

/**
 * #states config: show only when Supplier contact type is checked.
 */
function tec_crm_ux_supplier_visibility_states(): array {
  return [
    'visible' => [
      ':input[name="field_tec_contact_type[' . TEC_CRM_UX_TYPE_SUPPLIER . ']"]' => [
        'checked' => TRUE,
      ],
    ],
  ];
}

/**
 * Apply supplier visibility to fields and the Field Group fieldset.
 */
function tec_crm_ux_apply_supplier_visibility(array &$form): void {
  $states = tec_crm_ux_supplier_visibility_states();
  foreach (tec_crm_ux_supplier_field_names() as $field_name) {
    if (isset($form[$field_name])) {
      $form[$field_name]['#states'] = $states;
    }
  }
  if (isset($form['group_supplier'])) {
    $form['group_supplier']['#states'] = $states;
  }
  $form['#attached']['library'][] = 'core/drupal.states';
}

/**
 * Fields shown only when Contact type = Customer.
 *
 * The brand list says which brands this customer buys, and it is what the
 * Products tab of the contact groups by. On a contact that is only a supplier
 * it is noise, and worse, an invitation to fill it in by mistake.
 */
function tec_crm_ux_customer_field_names(): array {
  return [
    'field_tec_brands',
  ];
}

/**
 * #states config: show only when Customer contact type is checked.
 */
function tec_crm_ux_customer_visibility_states(): array {
  return [
    'visible' => [
      ':input[name="field_tec_contact_type[' . TEC_CRM_UX_TYPE_CUSTOMER . ']"]' => [
        'checked' => TRUE,
      ],
    ],
  ];
}

/**
 * Apply customer visibility to the customer-only fields.
 *
 * Hiding here is only for the eyes: #states does not stop a value that is
 * already saved from being submitted again, so nothing gets wiped by ticking
 * off Customer. What was filled in stays filled in.
 */
function tec_crm_ux_apply_customer_visibility(array &$form): void {
  $states = tec_crm_ux_customer_visibility_states();
  foreach (tec_crm_ux_customer_field_names() as $field_name) {
    if (isset($form[$field_name])) {
      $form[$field_name]['#states'] = $states;
    }
  }
  $form['#attached']['library'][] = 'core/drupal.states';
}

/**
 * Implements hook_field_group_form_process_alter().
 *
 * Field Group rebuilds group_supplier after hook_form_alter(), so #states set
 * there are discarded. Re-apply while the fieldset element is built.
 */
function tec_crm_ux_field_group_form_process_alter(array &$element, &$group, &$complete_form): void {
  if (($group->group_name ?? '') !== 'group_supplier') {
    return;
  }
  $element['#states'] = tec_crm_ux_supplier_visibility_states();
}

/**
 * Build a display title for a person from field_tec_name.
 */
function tec_crm_ux_person_title_from_name(FieldableEntityInterface $entity): string {
  if (!$entity->hasField('field_tec_name') || $entity->get('field_tec_name')->isEmpty()) {
    return '';
  }
  $item = $entity->get('field_tec_name')->first();
  if (!$item) {
    return '';
  }
  $parts = array_filter([
    trim((string) ($item->given ?? '')),
    trim((string) ($item->family ?? '')),
  ], static fn($p) => $p !== '');
  return trim(implode(' ', $parts));
}

/**
 * Implements hook_entity_presave().
 *
 * Person bundles hide the entity title field, so lists that use title show a
 * blank row. Keep title in sync with Given + Family from field_tec_name.
 */
function tec_crm_ux_entity_presave(EntityInterface $entity): void {
  if ($entity->getEntityTypeId() !== 'tec_crm' || !$entity instanceof FieldableEntityInterface) {
    return;
  }

  tec_crm_ux_drop_repeated_brands($entity);
  tec_crm_ux_scrub_entity_address($entity);

  if ($entity->bundle() !== 'tec_contact_person' || !$entity->hasField('title')) {
    return;
  }
  $title = tec_crm_ux_person_title_from_name($entity);
  if ($title !== '') {
    $entity->set('title', $title);
  }
}

/**
 * Leave one row per brand in the customer's brand list.
 *
 * The list answers "which brands do we make for this customer", so it is a set:
 * saying Rise Fight Gear twice adds nothing, and there is no widget button for
 * "remove the duplicate I just created" that is any easier than this.
 *
 * It is not cosmetic. The one-click draft order -the + Order flag- asks a
 * view for every size of every product of the customer's brands, and that view
 * reaches the customer through this list. A brand listed twice joins twice, so
 * the order comes out with every line duplicated. That was measured, not
 * guessed: with the brand repeated the view returned four rows instead of two.
 *
 * Fixed here rather than with DISTINCT in the view because the query is not the
 * one that is wrong. The guardian still counts duplicates, for the day something
 * writes to the field without coming through here.
 */
function tec_crm_ux_drop_repeated_brands(FieldableEntityInterface $entity): void {
  if (!$entity->hasField('field_tec_brands') || $entity->get('field_tec_brands')->isEmpty()) {
    return;
  }

  $seen = [];
  foreach ($entity->get('field_tec_brands')->getValue() as $item) {
    $tid = (string) ($item['target_id'] ?? '');
    // The order is the house's, so the first mention is the one that stays.
    if ($tid !== '' && !isset($seen[$tid])) {
      $seen[$tid] = ['target_id' => $tid];
    }
  }

  if (count($seen) !== $entity->get('field_tec_brands')->count()) {
    $entity->set('field_tec_brands', array_values($seen));
  }
}

/**
 * Implements hook_views_pre_render().
 *
 * Put the brand groups on the customer's Products tab in the customer's own
 * brand order.
 *
 * The tab lists the products of every brand the customer buys, grouped by
 * brand. Which brand comes first is the customer's decision: the brand list on
 * their record is dragged by hand, and that order is stored as each brand's
 * position in the list.
 *
 * Views can sort on that position -it offers the field list's delta- but not
 * from here: reaching it means joining the brand list a second time, and that
 * second join is not tied to the row's brand, so every product comes back once
 * per brand the customer buys. Measured, not guessed: three products turned
 * into six rows, and the one-click order built from a sibling query would have
 * come out with every line duplicated.
 *
 * So the rows are reordered after the query instead. Two things make that safe
 * here. The tab shows every row at once -no pager- so there is no page to sort
 * in isolation; and the sort is stable, which is what keeps the hand-dragged
 * product order intact inside each brand.
 */
function tec_crm_ux_views_pre_render(ViewExecutable $view): void {
  if ($view->id() !== 'tec_products' || $view->current_display !== 'block_4') {
    return;
  }
  $customer_id = $view->args[0] ?? NULL;
  if (!$customer_id || !$view->result) {
    return;
  }

  $customer = \Drupal::entityTypeManager()->getStorage('tec_crm')->load($customer_id);
  if (!$customer instanceof FieldableEntityInterface
    || !$customer->hasField('field_tec_brands')
    || $customer->get('field_tec_brands')->isEmpty()) {
    return;
  }

  $position = [];
  foreach ($customer->get('field_tec_brands') as $delta => $item) {
    $tid = (int) ($item->target_id ?? 0);
    if ($tid && !isset($position[$tid])) {
      $position[$tid] = $delta;
    }
  }

  $keyed = [];
  foreach ($view->result as $index => $row) {
    $brand = 0;
    if ($row->_entity instanceof FieldableEntityInterface && $row->_entity->hasField('field_tec_brand')) {
      $brand = (int) ($row->_entity->get('field_tec_brand')->first()?->target_id ?? 0);
    }
    // A product whose brand the customer does not buy cannot normally show up
    // here, and a product with no brand at all can: both go last.
    $keyed[] = [$position[$brand] ?? PHP_INT_MAX, $index, $row];
  }

  // The row's original place is the tie-breaker, so products inside one brand
  // keep the order they were dragged into.
  usort($keyed, static fn(array $a, array $b) => [$a[0], $a[1]] <=> [$b[0], $b[1]]);

  $view->result = [];
  foreach ($keyed as $index => [, , $row]) {
    $row->index = $index;
    $view->result[$index] = $row;
  }
}

/**
 * Resolve contact-type term ID from ?tipo=supplier|customer.
 */
function tec_crm_ux_tipo_tid(): ?int {
  $tipo = strtolower((string) \Drupal::request()->query->get('tipo', ''));
  return match ($tipo) {
    'supplier' => TEC_CRM_UX_TYPE_SUPPLIER,
    'customer' => TEC_CRM_UX_TYPE_CUSTOMER,
    default => NULL,
  };
}

/**
 * Human label for the tipo query param.
 */
function tec_crm_ux_tipo_label(): ?string {
  return match (strtolower((string) \Drupal::request()->query->get('tipo', ''))) {
    'supplier' => 'Supplier',
    'customer' => 'Customer',
    default => NULL,
  };
}

/**
 * Collect contact-type tids requested via the URL / entity for a new entity.
 */
function tec_crm_ux_requested_contact_type_tids(?FieldableEntityInterface $entity = NULL): array {
  $tids = [];
  if ($entity && $entity->hasField('field_tec_contact_type')) {
    foreach ($entity->get('field_tec_contact_type') as $item) {
      if ($item->target_id) {
        $tids[] = (int) $item->target_id;
      }
    }
  }
  if (!$tids && ($tid = tec_crm_ux_tipo_tid())) {
    $tids[] = $tid;
  }
  $prefill = \Drupal::request()->query->all()['prefill'] ?? [];
  if (!$tids && is_array($prefill) && !empty($prefill['field_tec_contact_type'])) {
    foreach ((array) $prefill['field_tec_contact_type'] as $raw) {
      if (is_scalar($raw) && (int) $raw > 0) {
        $tids[] = (int) $raw;
      }
    }
  }
  return array_values(array_unique($tids));
}

/**
 * Force Contact type checkbox / checkboxes widget to the given term ids.
 */
function tec_crm_ux_force_contact_type_widget(array &$widget, array $tids): void {
  if (!$tids) {
    return;
  }
  $widget['#default_value'] = $tids;
  foreach ($tids as $tid) {
    foreach ([$tid, (string) $tid] as $key) {
      if (isset($widget[$key]) && is_array($widget[$key])) {
        $widget[$key]['#default_value'] = $tid;
        $widget[$key]['#checked'] = TRUE;
        $widget[$key]['#attributes']['checked'] = 'checked';
      }
    }
  }
}

/**
 * Inline script: no Drupal.behaviors / once dependency.
 */
function tec_crm_ux_inline_prefill_script(array $tids): array {
  $json = json_encode(array_map('strval', $tids));
  return [
    '#type' => 'html_tag',
    '#tag' => 'script',
    '#value' => <<<JS
(function () {
  var tids = {$json};
  function apply() {
    tids.forEach(function (tid) {
      var box = document.querySelector('input[type="checkbox"][name="field_tec_contact_type[' + tid + ']"]');
      if (box && !box.checked) {
        box.checked = true;
        box.setAttribute('checked', 'checked');
        box.dispatchEvent(new Event('input', { bubbles: true }));
        box.dispatchEvent(new Event('change', { bubbles: true }));
      }
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', apply);
  } else {
    apply();
  }
  // Run again shortly in case a theme script resets inputs.
  setTimeout(apply, 100);
  setTimeout(apply, 500);
})();
JS
    ,
    '#weight' => 1000,
  ];
}

/**
 * Implements hook_entity_prepare_form().
 */
function tec_crm_ux_entity_prepare_form(EntityInterface $entity, $operation, FormStateInterface $form_state) {
  if (!$entity instanceof FieldableEntityInterface || !$entity->isNew()) {
    return;
  }

  $query = \Drupal::request()->query->all();

  if ($entity->getEntityTypeId() === 'tec_crm'
    && $entity->hasField('field_tec_contact_type')
    && $entity->get('field_tec_contact_type')->isEmpty()) {
    $tid = tec_crm_ux_tipo_tid();
    if ($tid) {
      $entity->set('field_tec_contact_type', [['target_id' => $tid]]);
    }
  }

  if ($entity->getEntityTypeId() === 'tec_crm'
    && $entity->bundle() === 'tec_contact_person'
    && $entity->hasField('field_tec_works_at')
    && $entity->get('field_tec_works_at')->isEmpty()
    && !empty($query['works_at'])) {
    $works_at = (int) $query['works_at'];
    if ($works_at > 0) {
      $org = \Drupal::entityTypeManager()->getStorage('tec_crm')->load($works_at);
      if ($org && $org->bundle() === 'tec_contact_organization') {
        $entity->set('field_tec_works_at', [['target_id' => $works_at]]);
      }
    }
  }

  if (empty($query['prefill']) || !is_array($query['prefill'])) {
    return;
  }

  foreach ($query['prefill'] as $field_name => $value) {
    if (!is_string($field_name) || !$entity->hasField($field_name)) {
      continue;
    }
    $definition = $entity->getFieldDefinition($field_name);
    if (!in_array($definition->getType(), TEC_CRM_UX_PREFILL_TYPES, TRUE)) {
      continue;
    }
    if (!$entity->get($field_name)->isEmpty()) {
      continue;
    }
    $values = array_filter((array) $value, 'is_scalar');
    if (!$values) {
      continue;
    }
    $cardinality = $definition->getFieldStorageDefinition()->getCardinality();
    if ($cardinality !== FieldStorageDefinitionInterface::CARDINALITY_UNLIMITED) {
      $values = array_slice($values, 0, $cardinality);
    }
    if ($definition->getType() === 'entity_reference') {
      $entity->set($field_name, array_map(
        static fn($id) => ['target_id' => $id],
        array_values($values)
      ));
    }
    else {
      $entity->set($field_name, array_values($values));
    }
  }
}

/**
 * Implements hook_field_widget_complete_form_alter().
 *
 * Runs while the Contact type widget is being built, so #default_value is in
 * place before Checkboxes::processCheckboxes creates the child boxes.
 *
 * Also hardens Address country AJAX on CRM forms (Field Group can break the
 * stock Address::ajaxRefresh() parent path and crash the Apache worker).
 */
function tec_crm_ux_field_widget_complete_form_alter(&$field_widget_complete_form, FormStateInterface $form_state, $context) {
  $field_name = $context['items']->getName() ?? '';
  $entity = $context['items']->getEntity();

  if ($field_name === 'field_tec_address'
    && $entity
    && $entity->getEntityTypeId() === 'tec_crm'
    && isset($field_widget_complete_form['widget'])) {
    foreach (Element::children($field_widget_complete_form['widget']) as $delta) {
      if (isset($field_widget_complete_form['widget'][$delta]['address'])) {
        $field_widget_complete_form['widget'][$delta]['address']['#after_build'][] = 'tec_crm_ux_address_after_build';
      }
    }
  }

  if ($field_name !== 'field_tec_contact_type') {
    return;
  }
  if (!$entity || !$entity->isNew() || $entity->getEntityTypeId() !== 'tec_crm') {
    return;
  }
  $tids = tec_crm_ux_requested_contact_type_tids($entity);
  if (!$tids) {
    return;
  }
  $entity->set('field_tec_contact_type', array_map(
    static fn($tid) => ['target_id' => $tid],
    $tids
  ));
  if (isset($field_widget_complete_form['widget'])) {
    tec_crm_ux_force_contact_type_widget($field_widget_complete_form['widget'], $tids);
  }
}

/**
 * #after_build for CRM address widgets.
 *
 * Address country AJAX once took down the Apache worker on this host, so it was
 * stripped out and the whole page reloaded on every country change instead.
 * That reload made the country list unusable: any stray change event, including
 * arrowing through the 250-odd options, posted the form mid-choice. The AJAX no
 * longer crashes, the integer #group keys neutralised below being the likely
 * cause, so it is back on and nothing reloads.
 */
function tec_crm_ux_address_after_build(array $element, FormStateInterface $form_state): array {
  tec_crm_ux_address_neutralize_group_keys($element);
  tec_crm_ux_address_clear_stale_fields($element, $form_state);

  $entity = NULL;
  $form_object = $form_state->getFormObject();
  if ($form_object instanceof EntityFormInterface) {
    $entity = $form_object->getEntity();
  }
  if ($entity instanceof FieldableEntityInterface
    && $entity->bundle() === 'tec_contact_organization') {
    tec_crm_ux_mark_country_for_customers($element, tec_crm_ux_form_needs_customer_country($entity));
  }

  return $element;
}

/**
 * Address uses integer #group for inline layout; Field Group/Form API treat
 * #group as structural grouping and can corrupt the AJAX rebuild tree.
 */
function tec_crm_ux_address_neutralize_group_keys(array &$element): void {
  foreach (Element::children($element) as $key) {
    if (!isset($element[$key]) || !is_array($element[$key])) {
      continue;
    }
    if (isset($element[$key]['#group']) && !is_string($element[$key]['#group'])) {
      unset($element[$key]['#group']);
    }
    tec_crm_ux_address_neutralize_group_keys($element[$key]);
  }
}

/**
 * Properties an address may keep for the current country.
 *
 * Address format validation rejects leftover fields: Thailand has a province
 * select, Singapore does not. Changing country used to leave the old province
 * in the submitted value, and save failed with a format error that looked like
 * the country itself had broken.
 */
function tec_crm_ux_address_keep_properties(string $country, $parsed_overrides = NULL): array {
  $keep = ['country_code', 'langcode'];
  if ($country === '') {
    return $keep;
  }

  $format = \Drupal::service('address.address_format_repository')->get($country);
  $hidden = [];
  if ($parsed_overrides instanceof FieldOverrides) {
    $hidden = $parsed_overrides->getHiddenFields();
  }
  elseif (is_array($parsed_overrides) && $parsed_overrides) {
    $normalized = [];
    foreach ($parsed_overrides as $field => $data) {
      $normalized[$field] = is_array($data) ? ($data['override'] ?? '') : $data;
    }
    $hidden = (new FieldOverrides($normalized))->getHiddenFields();
  }

  foreach (array_diff($format->getUsedFields(), $hidden) as $field) {
    $property = FieldHelper::getPropertyName($field);
    if ($property) {
      $keep[] = $property;
    }
  }

  return array_values(array_unique($keep));
}

/**
 * Drop address properties the current country does not use.
 */
function tec_crm_ux_scrub_address_value(array $value, $parsed_overrides = NULL): array {
  $country = strtoupper(trim((string) ($value['country_code'] ?? '')));
  $keep = array_flip(tec_crm_ux_address_keep_properties($country, $parsed_overrides));
  foreach (array_keys($value) as $key) {
    if ($key === 'country_code' || $key === 'langcode') {
      continue;
    }
    if (!isset($keep[$key])) {
      $value[$key] = '';
    }
  }
  return $value;
}

/**
 * Field overrides as AddressItem::getFieldOverrides() returns them.
 */
function tec_crm_ux_address_overrides_for_entity(?FieldableEntityInterface $entity): array {
  if (!$entity || !$entity->hasField('field_tec_address')) {
    return [];
  }
  $settings = $entity->getFieldDefinition('field_tec_address')->getSetting('field_overrides') ?? [];
  if (!is_array($settings) || !$settings) {
    return [];
  }
  $normalized = [];
  foreach ($settings as $field => $data) {
    $normalized[$field] = is_array($data) ? ($data['override'] ?? '') : $data;
  }
  return array_filter($normalized, static fn($override) => $override !== '');
}

/**
 * Clear leftover province / city / postcode when they no longer belong.
 *
 * Stock Address::clearValues() only blanks a dependent field if that field
 * still exists on the rebuilt form. Singapore has no province, so a Thailand
 * province survived the switch and then failed format validation.
 */
function tec_crm_ux_address_clear_stale_fields(array &$element, FormStateInterface $form_state): void {
  $parents = $element['#parents'] ?? [];
  if (!$parents) {
    return;
  }

  $input = &$form_state->getUserInput();
  $location_keys = [
    'dependent_locality',
    'locality',
    'administrative_area',
    'postal_code',
    'sorting_code',
  ];

  $triggering = $form_state->getTriggeringElement();
  $trigger_name = is_array($triggering) ? (string) end($triggering['#parents']) : '';
  if ($trigger_name === 'country_code') {
    foreach ($location_keys as $key) {
      NestedArray::setValue($input, array_merge($parents, [$key]), '');
      if (isset($element[$key]) && is_array($element[$key])) {
        $element[$key]['#value'] = '';
      }
      if (isset($element['#value']) && is_array($element['#value'])) {
        $element['#value'][$key] = '';
      }
    }
  }

  $overrides = $element['#parsed_field_overrides'] ?? ($element['#field_overrides'] ?? []);
  $current = is_array($element['#value'] ?? NULL) ? $element['#value'] : [];
  $clean = tec_crm_ux_scrub_address_value($current, $overrides);
  $element['#value'] = $clean;
  foreach ($clean as $key => $val) {
    if ($val === '' || $val === NULL) {
      NestedArray::setValue($input, array_merge($parents, [$key]), '');
    }
  }
}

/**
 * Country is required for customers, without preselecting a default country.
 *
 * Address::valueCallback() invents a country when the address element itself
 * is #required. Only the country select is marked required, and only when we
 * already know this card is a customer. Ticking Customer later uses #states.
 */
function tec_crm_ux_mark_country_for_customers(array &$element, bool $required_now): void {
  if (isset($element['country_code']['country_code']) && is_array($element['country_code']['country_code'])) {
    $select = &$element['country_code']['country_code'];
  }
  elseif (isset($element['country_code']) && is_array($element['country_code'])) {
    $select = &$element['country_code'];
  }
  else {
    return;
  }

  $select['#states']['required'] = [
    ':input[name="field_tec_contact_type[' . TEC_CRM_UX_TYPE_CUSTOMER . ']"]' => [
      'checked' => TRUE,
    ],
  ];
  if ($required_now) {
    $select['#required'] = TRUE;
  }
}

/**
 * Whether this organization form should treat country as required now.
 */
function tec_crm_ux_form_needs_customer_country(?FieldableEntityInterface $entity): bool {
  if ($entity && tec_crm_ux_entity_is_customer($entity)) {
    return TRUE;
  }
  if (tec_crm_ux_tipo_tid() === TEC_CRM_UX_TYPE_CUSTOMER) {
    return TRUE;
  }
  if ($entity) {
    foreach (tec_crm_ux_requested_contact_type_tids($entity) as $tid) {
      if ($tid === TEC_CRM_UX_TYPE_CUSTOMER) {
        return TRUE;
      }
    }
  }
  return FALSE;
}

/**
 * Country code from an address field, or empty.
 */
function tec_crm_ux_country_code(FieldableEntityInterface $entity): string {
  if (!$entity->hasField('field_tec_address') || $entity->get('field_tec_address')->isEmpty()) {
    return '';
  }
  return strtoupper(trim((string) $entity->get('field_tec_address')->country_code));
}

/**
 * Wipe unused address properties on a CRM entity before it is stored.
 */
function tec_crm_ux_scrub_entity_address(FieldableEntityInterface $entity): void {
  if (!$entity->hasField('field_tec_address') || $entity->get('field_tec_address')->isEmpty()) {
    return;
  }
  $overrides = tec_crm_ux_address_overrides_for_entity($entity);
  $items = [];
  $changed = FALSE;
  foreach ($entity->get('field_tec_address') as $item) {
    $original = $item->toArray();
    $clean = tec_crm_ux_scrub_address_value($original, $overrides);
    $items[] = $clean;
    if ($clean !== $original) {
      $changed = TRUE;
    }
  }
  if ($changed) {
    $entity->set('field_tec_address', $items);
  }
}

/**
 * Contact type term ids as submitted on the CRM form.
 */
function tec_crm_ux_submitted_contact_type_tids(FormStateInterface $form_state): array {
  $values = $form_state->getValue('field_tec_contact_type') ?? [];
  $selected = [];
  foreach ((array) $values as $delta => $item) {
    if (is_array($item) && !empty($item['target_id'])) {
      $selected[] = (int) $item['target_id'];
    }
    elseif (is_scalar($item) && (int) $item > 0 && !in_array($delta, ['add_more'], TRUE)) {
      if ((int) $item === (int) $delta || (int) $item > 0) {
        $selected[] = (int) ($item ?: $delta);
      }
    }
  }
  if (isset($values[1396]) || isset($values['1396']) || isset($values[1395]) || isset($values['1395'])) {
    $selected = [];
    foreach ($values as $key => $val) {
      if (is_numeric($key) && (string) $val === (string) $key) {
        $selected[] = (int) $key;
      }
    }
  }
  return array_values(array_unique($selected));
}

/**
 * Address rows as submitted, whether or not the widget has nested them.
 */
function tec_crm_ux_form_address_items(FormStateInterface $form_state): array {
  $raw = $form_state->getValue('field_tec_address');
  if (!is_array($raw)) {
    return [];
  }
  $items = [];
  foreach ($raw as $delta => $item) {
    if ($delta === 'add_more' || !is_array($item)) {
      continue;
    }
    $items[$delta] = (isset($item['address']) && is_array($item['address']))
      ? $item['address']
      : $item;
  }
  return $items;
}

/**
 * First submitted country code, or empty.
 */
function tec_crm_ux_form_address_country(FormStateInterface $form_state): string {
  foreach (tec_crm_ux_form_address_items($form_state) as $item) {
    $code = strtoupper(trim((string) ($item['country_code'] ?? '')));
    if ($code !== '') {
      return $code;
    }
  }
  return '';
}

/**
 * Scrub leftover address properties in form state before entity validation.
 */
function tec_crm_ux_scrub_address_in_form_state(FormStateInterface $form_state, ?FieldableEntityInterface $entity): void {
  $raw = $form_state->getValue('field_tec_address');
  if (!is_array($raw)) {
    return;
  }
  $overrides = tec_crm_ux_address_overrides_for_entity($entity);
  foreach ($raw as $delta => $item) {
    if ($delta === 'add_more' || !is_array($item)) {
      continue;
    }
    if (isset($item['address']) && is_array($item['address'])) {
      $raw[$delta]['address'] = tec_crm_ux_scrub_address_value($item['address'], $overrides);
    }
    else {
      $raw[$delta] = tec_crm_ux_scrub_address_value($item, $overrides);
    }
  }
  $form_state->setValue('field_tec_address', $raw);
}

/**
 * #after_build callback: re-apply URL prefill after widgets/field_group run.
 */
function tec_crm_ux_contact_form_after_build(array $form, FormStateInterface $form_state): array {
  /** @var \Drupal\Core\Entity\EntityFormInterface $form_object */
  $form_object = $form_state->getFormObject();
  $entity = $form_object->getEntity();
  if ($entity->isNew() && !$form_state->isSubmitted()) {
    $tids = tec_crm_ux_requested_contact_type_tids($entity);
    if ($tids && isset($form['field_tec_contact_type']['widget'])) {
      $entity->set('field_tec_contact_type', array_map(
        static fn($tid) => ['target_id' => $tid],
        $tids
      ));
      tec_crm_ux_force_contact_type_widget($form['field_tec_contact_type']['widget'], $tids);
    }
  }
  // Field Group may rebuild the fieldset after form_alter; keep states alive.
  tec_crm_ux_apply_supplier_visibility($form);
  tec_crm_ux_apply_customer_visibility($form);
  return $form;
}

/**
 * Validation: keep the URL-selected contact type, require a country on customers.
 *
 * Runs before EntityForm::validateForm so leftover address properties are gone
 * before Address format constraints see them, and so a missing country is a
 * form error instead of a constraint dump.
 */
function tec_crm_ux_contact_form_validate(array &$form, FormStateInterface $form_state): void {
  $form_object = $form_state->getFormObject();
  $entity = $form_object instanceof EntityFormInterface ? $form_object->getEntity() : NULL;

  $selected = tec_crm_ux_submitted_contact_type_tids($form_state);
  $tid = tec_crm_ux_tipo_tid();
  if ($tid && !in_array($tid, $selected, TRUE)) {
    $selected[] = $tid;
    $form_state->setValue('field_tec_contact_type', array_map(
      static fn($id) => ['target_id' => $id],
      array_values(array_unique($selected))
    ));
  }

  if (!$entity instanceof FieldableEntityInterface || $entity->bundle() !== 'tec_contact_organization') {
    return;
  }

  tec_crm_ux_scrub_address_in_form_state($form_state, $entity);

  $es_cliente = in_array(TEC_CRM_UX_TYPE_CUSTOMER, $selected, TRUE)
    || ($selected === [] && tec_crm_ux_entity_is_customer($entity));
  if (!$es_cliente) {
    return;
  }

  if (tec_crm_ux_form_address_country($form_state) !== '') {
    return;
  }

  $mensaje = t('A customer needs a country.');
  if (isset($form['field_tec_address']['widget'][0]['address']['country_code']['country_code'])) {
    $form_state->setError($form['field_tec_address']['widget'][0]['address']['country_code']['country_code'], $mensaje);
  }
  elseif (isset($form['field_tec_address'])) {
    $form_state->setError($form['field_tec_address'], $mensaje);
  }
  else {
    $form_state->setErrorByName('field_tec_address', $mensaje);
  }
}

/**
 * Implements hook_form_alter().
 */
function tec_crm_ux_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  if (!in_array($form_id, [
    'tec_crm_tec_contact_organization_form',
    'tec_crm_tec_contact_person_form',
  ], TRUE)) {
    return;
  }

  /** @var \Drupal\Core\Entity\EntityFormInterface $form_object */
  $form_object = $form_state->getFormObject();
  $entity = $form_object->getEntity();

  $form['#attributes']['class'][] = 'tec-crm-contact-form';
  $form['#attached']['library'][] = 'tec_crm_ux/prefill';
  $form['#after_build'][] = 'tec_crm_ux_contact_form_after_build';
  $form['#validate'] = $form['#validate'] ?? [];
  array_unshift($form['#validate'], 'tec_crm_ux_contact_form_validate');
  $form['#cache']['contexts'][] = 'url.query_args:tipo';
  $form['#cache']['contexts'][] = 'url.query_args:prefill';
  $form['#cache']['contexts'][] = 'url.query_args:works_at';

  if ($entity->isNew() && !$form_state->isSubmitted()) {
    $tids = tec_crm_ux_requested_contact_type_tids($entity);
    if ($tids) {
      $entity->set('field_tec_contact_type', array_map(
        static fn($tid) => ['target_id' => $tid],
        $tids
      ));
      if (isset($form['field_tec_contact_type']['widget'])) {
        tec_crm_ux_force_contact_type_widget($form['field_tec_contact_type']['widget'], $tids);
      }

      $label = tec_crm_ux_tipo_label() ?? 'selected type';
      $form['tec_crm_ux_prefill_notice'] = [
        '#type' => 'markup',
        '#markup' => '<div class="messages messages--status" role="status" style="margin-bottom:1rem;"><strong>Contact type:</strong> ' . $label . ' (preselected from the page you came from). You can still change it below.</div>',
        '#weight' => -100,
      ];
      $form['tec_crm_ux_prefill_js'] = tec_crm_ux_inline_prefill_script($tids);
    }
  }

  if ($entity->isNew()
    && $form_id === 'tec_crm_tec_contact_person_form'
    && isset($form['field_tec_works_at']['widget'][0]['target_id'])
    && $entity->get('field_tec_works_at')->isEmpty()) {
    $works_at = (int) \Drupal::request()->query->get('works_at', 0);
    if ($works_at > 0) {
      $org = \Drupal::entityTypeManager()->getStorage('tec_crm')->load($works_at);
      if ($org && $org->bundle() === 'tec_contact_organization') {
        $entity->set('field_tec_works_at', [['target_id' => $works_at]]);
        $form['field_tec_works_at']['widget'][0]['target_id']['#default_value'] = $org;
      }
    }
  }

  tec_crm_ux_apply_supplier_visibility($form);
  tec_crm_ux_apply_customer_visibility($form);
}

/**
 * Whether a CRM contact has Contact type = Customer.
 */
function tec_crm_ux_entity_is_customer(FieldableEntityInterface $entity): bool {
  if (!$entity->hasField('field_tec_contact_type') || $entity->get('field_tec_contact_type')->isEmpty()) {
    return FALSE;
  }
  foreach ($entity->get('field_tec_contact_type') as $item) {
    if ((int) $item->target_id === TEC_CRM_UX_TYPE_CUSTOMER) {
      return TRUE;
    }
  }
  return FALSE;
}

/**
 * Whether a CRM contact has Contact type = Supplier.
 */
function tec_crm_ux_entity_is_supplier(FieldableEntityInterface $entity): bool {
  if (!$entity->hasField('field_tec_contact_type') || $entity->get('field_tec_contact_type')->isEmpty()) {
    return FALSE;
  }
  foreach ($entity->get('field_tec_contact_type') as $item) {
    if ((int) $item->target_id === TEC_CRM_UX_TYPE_SUPPLIER) {
      return TRUE;
    }
  }
  return FALSE;
}

/**
 * Implements hook_entity_field_access().
 *
 * Hide supplier purchase fields on view pages when the contact is not a
 * Supplier. Edit forms keep the fields (shown/hidden via #states).
 */
function tec_crm_ux_entity_field_access($operation, FieldDefinitionInterface $field_definition, AccountInterface $account, FieldItemListInterface $items = NULL) {
  if ($operation !== 'view' || !$items) {
    return AccessResult::neutral();
  }
  if (!in_array($field_definition->getName(), tec_crm_ux_supplier_field_names(), TRUE)) {
    return AccessResult::neutral();
  }
  $entity = $items->getEntity();
  if ($entity->getEntityTypeId() !== 'tec_crm') {
    return AccessResult::neutral();
  }
  $result = tec_crm_ux_entity_is_supplier($entity)
    ? AccessResult::neutral()
    : AccessResult::forbidden('Supplier fields are only shown for Supplier contacts.');
  return $result->addCacheableDependency($entity);
}

/**
 * Implements hook_ENTITY_TYPE_view() for tec_crm.
 */
function tec_crm_ux_tec_crm_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode) {
  if ($entity->bundle() !== 'tec_contact_organization') {
    return;
  }
  // Details tab only (view mode full_details). The card itself is view mode
  // "full", which uses the default display; listing contacts there duplicated
  // the table above the Orders / Products / Details tabs.
  if ($view_mode !== 'full_details') {
    return;
  }

  $build['tec_crm_contacts'] = [
    '#type' => 'container',
    '#attributes' => ['class' => ['tec-crm-org-contacts'], 'id' => 'contact-persons'],
    '#weight' => 100,
  ];

  $build['tec_crm_contacts']['title'] = [
    '#type' => 'html_tag',
    '#tag' => 'h2',
    '#value' => t('Contact persons'),
  ];

  $build['tec_crm_contacts']['add'] = [
    '#type' => 'link',
    '#title' => t('+ Add contact person'),
    '#url' => Url::fromUserInput('/admin/content/tec_crm/add/tec_contact_person', [
      'query' => [
        'works_at' => $entity->id(),
        'destination' => \Drupal::service('path.current')->getPath(),
      ],
    ]),
    '#attributes' => ['class' => ['button', 'button--small']],
    '#weight' => -10,
  ];

  $view = Views::getView('tec_crm_org_contacts');
  if ($view) {
    $build['tec_crm_contacts']['list'] = $view->buildRenderable('block_1', [(string) $entity->id()]);
  }
  else {
    $build['tec_crm_contacts']['empty'] = [
      '#markup' => '<p>' . t('No contact persons linked yet. Use “Add contact person” above.') . '</p>',
    ];
  }
}
