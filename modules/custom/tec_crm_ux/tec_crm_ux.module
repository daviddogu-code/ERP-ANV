<?php

/**
 * @file
 * Usability fixes for the CRM contact forms.
 */

use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\FieldableEntityInterface;
use Drupal\Core\Field\FieldStorageDefinitionInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;
use Drupal\views\Views;

/**
 * Contact type taxonomy term IDs.
 */
const TEC_CRM_UX_TYPE_CUSTOMER = 1395;
const TEC_CRM_UX_TYPE_SUPPLIER = 1396;

/**
 * Field types a URL is allowed to prefill.
 */
const TEC_CRM_UX_PREFILL_TYPES = [
  'boolean',
  'entity_reference',
  'list_float',
  'list_integer',
  'list_string',
];

/**
 * Purchase / supplier fields shown only when Contact type = Supplier.
 */
function tec_crm_ux_supplier_field_names(): array {
  return [
    'field_tec_purchase_currency',
    'field_tec_incoterm',
    'field_tec_payment_terms',
    'field_tec_supplier_code',
    'field_tec_website',
    'field_tec_supplier_active',
  ];
}

/**
 * Resolve contact-type term ID from ?tipo=supplier|customer.
 */
function tec_crm_ux_tipo_tid(): ?int {
  $tipo = strtolower((string) \Drupal::request()->query->get('tipo', ''));
  return match ($tipo) {
    'supplier' => TEC_CRM_UX_TYPE_SUPPLIER,
    'customer' => TEC_CRM_UX_TYPE_CUSTOMER,
    default => NULL,
  };
}

/**
 * Human label for the tipo query param.
 */
function tec_crm_ux_tipo_label(): ?string {
  return match (strtolower((string) \Drupal::request()->query->get('tipo', ''))) {
    'supplier' => 'Supplier',
    'customer' => 'Customer',
    default => NULL,
  };
}

/**
 * Collect contact-type tids requested via the URL / entity for a new entity.
 */
function tec_crm_ux_requested_contact_type_tids(?FieldableEntityInterface $entity = NULL): array {
  $tids = [];
  if ($entity && $entity->hasField('field_tec_contact_type')) {
    foreach ($entity->get('field_tec_contact_type') as $item) {
      if ($item->target_id) {
        $tids[] = (int) $item->target_id;
      }
    }
  }
  if (!$tids && ($tid = tec_crm_ux_tipo_tid())) {
    $tids[] = $tid;
  }
  $prefill = \Drupal::request()->query->all()['prefill'] ?? [];
  if (!$tids && is_array($prefill) && !empty($prefill['field_tec_contact_type'])) {
    foreach ((array) $prefill['field_tec_contact_type'] as $raw) {
      if (is_scalar($raw) && (int) $raw > 0) {
        $tids[] = (int) $raw;
      }
    }
  }
  return array_values(array_unique($tids));
}

/**
 * Force Contact type checkbox / checkboxes widget to the given term ids.
 */
function tec_crm_ux_force_contact_type_widget(array &$widget, array $tids): void {
  if (!$tids) {
    return;
  }
  $widget['#default_value'] = $tids;
  foreach ($tids as $tid) {
    foreach ([$tid, (string) $tid] as $key) {
      if (isset($widget[$key]) && is_array($widget[$key])) {
        $widget[$key]['#default_value'] = $tid;
        $widget[$key]['#checked'] = TRUE;
        $widget[$key]['#attributes']['checked'] = 'checked';
      }
    }
  }
}

/**
 * Inline script: no Drupal.behaviors / once dependency.
 */
function tec_crm_ux_inline_prefill_script(array $tids): array {
  $json = json_encode(array_map('strval', $tids));
  return [
    '#type' => 'html_tag',
    '#tag' => 'script',
    '#value' => <<<JS
(function () {
  var tids = {$json};
  function apply() {
    tids.forEach(function (tid) {
      var box = document.querySelector('input[type="checkbox"][name="field_tec_contact_type[' + tid + ']"]');
      if (box && !box.checked) {
        box.checked = true;
        box.setAttribute('checked', 'checked');
        box.dispatchEvent(new Event('input', { bubbles: true }));
        box.dispatchEvent(new Event('change', { bubbles: true }));
      }
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', apply);
  } else {
    apply();
  }
  // Run again shortly in case a theme script resets inputs.
  setTimeout(apply, 100);
  setTimeout(apply, 500);
})();
JS
    ,
    '#weight' => 1000,
  ];
}

/**
 * Implements hook_entity_prepare_form().
 */
function tec_crm_ux_entity_prepare_form(EntityInterface $entity, $operation, FormStateInterface $form_state) {
  if (!$entity instanceof FieldableEntityInterface || !$entity->isNew()) {
    return;
  }

  $query = \Drupal::request()->query->all();

  if ($entity->getEntityTypeId() === 'tec_crm'
    && $entity->hasField('field_tec_contact_type')
    && $entity->get('field_tec_contact_type')->isEmpty()) {
    $tid = tec_crm_ux_tipo_tid();
    if ($tid) {
      $entity->set('field_tec_contact_type', [['target_id' => $tid]]);
    }
  }

  if ($entity->getEntityTypeId() === 'tec_crm'
    && $entity->bundle() === 'tec_contact_person'
    && $entity->hasField('field_tec_works_at')
    && $entity->get('field_tec_works_at')->isEmpty()
    && !empty($query['works_at'])) {
    $works_at = (int) $query['works_at'];
    if ($works_at > 0) {
      $org = \Drupal::entityTypeManager()->getStorage('tec_crm')->load($works_at);
      if ($org && $org->bundle() === 'tec_contact_organization') {
        $entity->set('field_tec_works_at', [['target_id' => $works_at]]);
      }
    }
  }

  if (empty($query['prefill']) || !is_array($query['prefill'])) {
    return;
  }

  foreach ($query['prefill'] as $field_name => $value) {
    if (!is_string($field_name) || !$entity->hasField($field_name)) {
      continue;
    }
    $definition = $entity->getFieldDefinition($field_name);
    if (!in_array($definition->getType(), TEC_CRM_UX_PREFILL_TYPES, TRUE)) {
      continue;
    }
    if (!$entity->get($field_name)->isEmpty()) {
      continue;
    }
    $values = array_filter((array) $value, 'is_scalar');
    if (!$values) {
      continue;
    }
    $cardinality = $definition->getFieldStorageDefinition()->getCardinality();
    if ($cardinality !== FieldStorageDefinitionInterface::CARDINALITY_UNLIMITED) {
      $values = array_slice($values, 0, $cardinality);
    }
    if ($definition->getType() === 'entity_reference') {
      $entity->set($field_name, array_map(
        static fn($id) => ['target_id' => $id],
        array_values($values)
      ));
    }
    else {
      $entity->set($field_name, array_values($values));
    }
  }
}

/**
 * Implements hook_field_widget_complete_form_alter().
 *
 * Runs while the Contact type widget is being built, so #default_value is in
 * place before Checkboxes::processCheckboxes creates the child boxes.
 */
function tec_crm_ux_field_widget_complete_form_alter(&$field_widget_complete_form, FormStateInterface $form_state, $context) {
  if (($context['items']->getName() ?? '') !== 'field_tec_contact_type') {
    return;
  }
  $entity = $context['items']->getEntity();
  if (!$entity || !$entity->isNew() || $entity->getEntityTypeId() !== 'tec_crm') {
    return;
  }
  $tids = tec_crm_ux_requested_contact_type_tids($entity);
  if (!$tids) {
    return;
  }
  $entity->set('field_tec_contact_type', array_map(
    static fn($tid) => ['target_id' => $tid],
    $tids
  ));
  if (isset($field_widget_complete_form['widget'])) {
    tec_crm_ux_force_contact_type_widget($field_widget_complete_form['widget'], $tids);
  }
}

/**
 * #after_build callback: re-apply URL prefill after widgets/field_group run.
 */
function tec_crm_ux_contact_form_after_build(array $form, FormStateInterface $form_state): array {
  /** @var \Drupal\Core\Entity\EntityFormInterface $form_object */
  $form_object = $form_state->getFormObject();
  $entity = $form_object->getEntity();
  if ($entity->isNew() && !$form_state->isSubmitted()) {
    $tids = tec_crm_ux_requested_contact_type_tids($entity);
    if ($tids && isset($form['field_tec_contact_type']['widget'])) {
      $entity->set('field_tec_contact_type', array_map(
        static fn($tid) => ['target_id' => $tid],
        $tids
      ));
      tec_crm_ux_force_contact_type_widget($form['field_tec_contact_type']['widget'], $tids);
    }
  }
  return $form;
}

/**
 * Validation: never lose the URL-selected contact type on save.
 */
function tec_crm_ux_contact_form_validate(array &$form, FormStateInterface $form_state): void {
  $tid = tec_crm_ux_tipo_tid();
  if (!$tid) {
    return;
  }
  $values = $form_state->getValue('field_tec_contact_type') ?? [];
  $selected = [];
  foreach ((array) $values as $delta => $item) {
    if (is_array($item) && !empty($item['target_id'])) {
      $selected[] = (int) $item['target_id'];
    }
    elseif (is_scalar($item) && (int) $item > 0 && !in_array($delta, ['add_more'], TRUE)) {
      // Checkboxes widget may submit as tid => tid|0.
      if ((int) $item === (int) $delta || (int) $item > 0) {
        $selected[] = (int) ($item ?: $delta);
      }
    }
  }
  // Options checkboxes often look like [1396 => '1396', 1395 => 0].
  if (isset($values[1396]) || isset($values['1396']) || isset($values[1395]) || isset($values['1395'])) {
    $selected = [];
    foreach ($values as $key => $val) {
      if (is_numeric($key) && (string) $val === (string) $key) {
        $selected[] = (int) $key;
      }
    }
  }
  if (!in_array($tid, $selected, TRUE)) {
    $selected[] = $tid;
    $form_state->setValue('field_tec_contact_type', array_map(
      static fn($id) => ['target_id' => $id],
      array_values(array_unique($selected))
    ));
  }
}

/**
 * Implements hook_form_alter().
 */
function tec_crm_ux_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  if (!in_array($form_id, [
    'tec_crm_tec_contact_organization_form',
    'tec_crm_tec_contact_person_form',
  ], TRUE)) {
    return;
  }

  /** @var \Drupal\Core\Entity\EntityFormInterface $form_object */
  $form_object = $form_state->getFormObject();
  $entity = $form_object->getEntity();

  $form['#attributes']['class'][] = 'tec-crm-contact-form';
  $form['#attached']['library'][] = 'tec_crm_ux/prefill';
  $form['#after_build'][] = 'tec_crm_ux_contact_form_after_build';
  $form['#validate'][] = 'tec_crm_ux_contact_form_validate';
  $form['#cache']['max-age'] = 0;
  $form['#cache']['contexts'][] = 'url.query_args:tipo';
  $form['#cache']['contexts'][] = 'url.query_args:prefill';
  $form['#cache']['contexts'][] = 'url.query_args:works_at';

  if ($entity->isNew() && !$form_state->isSubmitted()) {
    $tids = tec_crm_ux_requested_contact_type_tids($entity);
    if ($tids) {
      $entity->set('field_tec_contact_type', array_map(
        static fn($tid) => ['target_id' => $tid],
        $tids
      ));
      if (isset($form['field_tec_contact_type']['widget'])) {
        tec_crm_ux_force_contact_type_widget($form['field_tec_contact_type']['widget'], $tids);
      }

      $label = tec_crm_ux_tipo_label() ?? 'selected type';
      $form['tec_crm_ux_prefill_notice'] = [
        '#type' => 'markup',
        '#markup' => '<div class="messages messages--status" role="status" style="margin-bottom:1rem;"><strong>Contact type:</strong> ' . $label . ' (preselected from the page you came from). You can still change it below.</div>',
        '#weight' => -100,
      ];
      $form['tec_crm_ux_prefill_js'] = tec_crm_ux_inline_prefill_script($tids);
    }
  }

  if ($entity->isNew()
    && $form_id === 'tec_crm_tec_contact_person_form'
    && isset($form['field_tec_works_at']['widget'][0]['target_id'])
    && $entity->get('field_tec_works_at')->isEmpty()) {
    $works_at = (int) \Drupal::request()->query->get('works_at', 0);
    if ($works_at > 0) {
      $org = \Drupal::entityTypeManager()->getStorage('tec_crm')->load($works_at);
      if ($org && $org->bundle() === 'tec_contact_organization') {
        $entity->set('field_tec_works_at', [['target_id' => $works_at]]);
        $form['field_tec_works_at']['widget'][0]['target_id']['#default_value'] = $org;
      }
    }
  }

  $selector = ':input[name="field_tec_contact_type[' . TEC_CRM_UX_TYPE_SUPPLIER . ']"]';
  $states = [
    'visible' => [
      $selector => ['checked' => TRUE],
    ],
  ];
  foreach (tec_crm_ux_supplier_field_names() as $field_name) {
    if (isset($form[$field_name])) {
      $form[$field_name]['#states'] = $states;
    }
  }
  if (isset($form['group_supplier'])) {
    $form['group_supplier']['#states'] = $states;
  }
}

/**
 * Implements hook_ENTITY_TYPE_view() for tec_crm.
 */
function tec_crm_ux_tec_crm_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode) {
  if ($entity->bundle() !== 'tec_contact_organization') {
    return;
  }
  if (in_array($view_mode, ['compact', 'excel_lover_button', 'p_o_button', 'print'], TRUE)) {
    return;
  }

  $build['tec_crm_contacts'] = [
    '#type' => 'container',
    '#attributes' => ['class' => ['tec-crm-org-contacts'], 'id' => 'contact-persons'],
    '#weight' => 100,
  ];

  $build['tec_crm_contacts']['title'] = [
    '#type' => 'html_tag',
    '#tag' => 'h2',
    '#value' => t('Contact persons'),
  ];

  $build['tec_crm_contacts']['add'] = [
    '#type' => 'link',
    '#title' => t('+ Add contact person'),
    '#url' => Url::fromUserInput('/admin/content/tec_crm/add/tec_contact_person', [
      'query' => [
        'works_at' => $entity->id(),
        'destination' => \Drupal::service('path.current')->getPath(),
      ],
    ]),
    '#attributes' => ['class' => ['button', 'button--small']],
    '#weight' => -10,
  ];

  $view = Views::getView('tec_crm_org_contacts');
  if ($view) {
    $build['tec_crm_contacts']['list'] = $view->buildRenderable('block_1', [(string) $entity->id()]);
  }
  else {
    $build['tec_crm_contacts']['empty'] = [
      '#markup' => '<p>' . t('No contact persons linked yet. Use “Add contact person” above.') . '</p>',
    ];
  }
}
