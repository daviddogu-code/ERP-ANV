<?php

/**
 * @file
 * TEC Inventory helpers.
 */

use Drupal\Component\Utility\NestedArray;
use Drupal\Core\Access\AccessResult;
use Drupal\Core\Entity\EntityFormInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\FieldableEntityInterface;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Url;
use Drupal\flag\FlagInterface;
use Drupal\taxonomy\Entity\Term;
use Drupal\tec_inventory\OrderBom;
use Drupal\tec_inventory\PatternRecipe;
use Drupal\views\Plugin\views\query\QueryPluginBase;
use Drupal\views\Plugin\views\query\Sql;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_page_attachments().
 *
 * Product size cards need the same full-width row and window-bottom scrollbar
 * as /o/queue. Pattern screens attach this via the pattern library.
 */
function tec_inventory_page_attachments(array &$attachments) {
  if (\Drupal::routeMatch()->getRouteName() === 'entity.tec_product.canonical') {
    $attachments['#attached']['library'][] = 'tec_inventory/size_cards';
    $attachments['#attached']['library'][] = 'tec_inventory/pattern';
  }
}

/**
 * Implements hook_preprocess_html().
 */
function tec_inventory_preprocess_html(array &$variables): void {
  $route = \Drupal::routeMatch()->getRouteName();
  if ($route === 'entity.tec_pattern.canonical') {
    $variables['attributes']['class'][] = 'tec-pattern-canonical';
  }
  if ($route !== 'entity.tec_product.canonical') {
    return;
  }
  $product = \Drupal::routeMatch()->getParameter('tec_product');
  if ($product instanceof EntityInterface && PatternRecipe::hasPattern($product)) {
    $variables['attributes']['class'][] = 'tec-patterned-product';
  }
}

/**
 * Implements hook_preprocess_field().
 *
 * Size cards get the scrollbar row class. Patterned colours hide + Size.
 */
function tec_inventory_preprocess_field(array &$variables): void {
  $name = $variables['field_name'] ?? '';
  if ($name === 'field_tec_size_variations') {
    // Bootstrap's field.html.twig hardcodes <div class="field__items"> and never
    // prints content_attributes, so the class has to live on the field wrapper.
    $variables['attributes']['class'][] = 'tec-size-cards-field';
    return;
  }
  if ($name !== 'field_tec_create_size') {
    return;
  }
  $entity = $variables['element']['#object'] ?? NULL;
  if (!$entity instanceof FieldableEntityInterface || !PatternRecipe::hasPattern($entity)) {
    return;
  }
  $variables['items'] = [];
}

/**
 * Implements hook_views_query_alter().
 *
 * The Products landing list (/p) sorts by brand and type. Shells with no
 * Product name have neither, so MySQL puts them on top as blank rows.
 */
function tec_inventory_views_query_alter(ViewExecutable $view, QueryPluginBase $query): void {
  if ($view->id() !== 'tec_products' || $view->current_display !== 'block_1') {
    return;
  }
  if (!$query instanceof Sql) {
    return;
  }
  $alias = $query->ensureTable('tec_product__field_product_name');
  if (!$alias) {
    return;
  }
  $query->addWhere(1, $alias . '.field_product_name_value', '', '<>');
}

/**
 * Implements hook_views_pre_render().
 *
 * Create size embed is a Views rewrite, so Layout Builder never sees the
 * field #access from hook_entity_view. Empty the embed when the colour
 * hangs from a pattern.
 */
function tec_inventory_views_pre_render(ViewExecutable $view): void {
  if ($view->id() !== 'tec_product_elements' || $view->current_display !== 'embed_5') {
    return;
  }
  $id = (int) ($view->args[0] ?? 0);
  if ($id <= 0) {
    return;
  }
  $entity = \Drupal::entityTypeManager()->getStorage('tec_product')->load($id);
  if (!$entity instanceof EntityInterface || !PatternRecipe::hasPattern($entity)) {
    return;
  }
  $view->result = [];
  $view->total_rows = 0;
  $product = PatternRecipe::productOf($entity);
  $view->element['#cache']['tags'] = array_merge(
    $view->element['#cache']['tags'] ?? [],
    $entity->getCacheTags(),
    $product ? $product->getCacheTags() : []
  );
}

/**
 * Implements hook_entity_field_access().
 *
 * Layout Builder FieldBlock consults field access, not hook_entity_view.
 */
function tec_inventory_entity_field_access($operation, FieldDefinitionInterface $field_definition, AccountInterface $account, ?FieldItemListInterface $items = NULL) {
  if ($operation !== 'view') {
    return AccessResult::neutral();
  }
  if ($field_definition->getName() !== 'field_tec_create_size' || $field_definition->getTargetEntityTypeId() !== 'tec_product') {
    return AccessResult::neutral();
  }
  if (!$items) {
    return AccessResult::neutral();
  }
  return _tec_inventory_forbidden_when_patterned($items->getEntity());
}

/**
 * Implements hook_flag_action_access().
 *
 * Duplicate size / Duplicate variation are flags. Duplicate product stays.
 */
function tec_inventory_flag_action_access($action, FlagInterface $flag, AccountInterface $account, ?EntityInterface $flaggable = NULL) {
  if (!in_array($flag->id(), ['tec_product_duplicate_size', 'tec_product_duplicate_color'], TRUE)) {
    return AccessResult::neutral();
  }
  if (!$flaggable) {
    return AccessResult::neutral();
  }
  return _tec_inventory_forbidden_when_patterned($flaggable);
}

/**
 * Forbidden when this catalogue row hangs from a factory pattern.
 */
function _tec_inventory_forbidden_when_patterned(EntityInterface $entity): AccessResult {
  $result = AccessResult::forbiddenIf(PatternRecipe::hasPattern($entity));
  $result->addCacheableDependency($entity);
  $product = PatternRecipe::productOf($entity);
  if ($product) {
    $result->addCacheableDependency($product);
  }
  return $result;
}

/**
 * Implements hook_entity_presave().
 *
 * A sales line snapshot is planned here, while the previous size and quantity
 * are still on the entity. Nested saves from ECA clear that afterwards.
 *
 * BoM "Production requires" formulas are evaluated locally (e.g. 1/12 → 0.0833…)
 * instead of calling OpenAI via AI Interpolator during IEF AJAX create.
 */
function tec_inventory_entity_presave(EntityInterface $entity) {
  OrderBom::remember($entity);

  if (
    !$entity instanceof FieldableEntityInterface
    || $entity->getEntityTypeId() !== 'tec_inventory'
    || $entity->bundle() !== 'tec_bom_item'
  ) {
    return;
  }

  if (
    !$entity->hasField('field_tec_quantity_input')
    || !$entity->hasField('field_tec_quantity')
    || $entity->get('field_tec_quantity_input')->isEmpty()
  ) {
    return;
  }

  _tec_inventory_apply_quantity_formula($entity);
}

/**
 * Implements hook_entity_insert().
 *
 * A new sales line gets a photo of its size BoM. ECA still sets title, sales
 * total and the lock; it no longer writes the line BoM.
 */
function tec_inventory_entity_insert(EntityInterface $entity) {
  OrderBom::sync($entity);
}

/**
 * Implements hook_entity_update().
 *
 * Quantity changes rescale the frozen per-piece required. A new size takes a
 * new photo from today's catalogue.
 */
function tec_inventory_entity_update(EntityInterface $entity) {
  OrderBom::sync($entity);
}

/**
 * Implements hook_ENTITY_TYPE_presave() for tec_product.
 *
 * Three repairs that all exist for the same reason: the ECA processes that used
 * to do this work only fire on insert, or only when a field is still empty, so
 * anything created in an unexpected order stayed wrong forever. Presave asks
 * the question again on every save, whatever created the entity, without extra
 * saves or recursion.
 *
 * The first keeps every name in the tree on the field it is deduced from.
 *
 * The second ties a size back to its color, and the third keeps the shortcut
 * every color and size stores straight to its product. Both fill a way back up
 * the tree that some other part of the ERP takes for granted. The color goes
 * first, because knowing the color is one of the ways of finding the product.
 */
function tec_inventory_tec_product_presave(EntityInterface $entity) {
  if (!$entity instanceof FieldableEntityInterface) {
    return;
  }
  _tec_inventory_name_from_source($entity);
  if ($entity->bundle() === 'tec_size_variation') {
    _tec_inventory_keep_color_shortcut($entity);
  }
  if (in_array($entity->bundle(), ['tec_color_variation', 'tec_size_variation'], TRUE)) {
    _tec_inventory_keep_product_shortcut($entity);
  }
}

/**
 * Implements hook_ENTITY_TYPE_predelete() for tec_product.
 *
 * Takes the whole branch down: a product takes its colors, a color takes its
 * sizes and a size takes its BoM lines.
 *
 * Until 18 August 2026 that job belonged to the ECA process "TEC Products:
 * Deletion routine", and it only did the middle of it. The routine has exactly
 * two delete actions and both say "Delete the Size", so deleting a product
 * killed its colors' sizes and left the colors standing: childless, pointing at
 * a product that no longer answers. Nobody took the BoM lines either, and those
 * are worse, because a BoM line is only reachable through its size, so once the
 * size is gone the line cannot be seen from any screen ever again. Both leaks
 * left evidence from a single test product deleted on 14 August: color 888
 * survived product 887, and lines 29700 and 29701 survived size 889.
 *
 * The cascade lives here now, and it does not trust the parent's list. It also
 * asks who points up at the parent, because a child missing from the list still
 * exists and would otherwise be left behind by exactly the accident this is
 * meant to clean up after.
 *
 * The only thing it refuses to take is a BoM line that another size is also
 * using. Nothing shares lines today -duplicating a size copies them rather than
 * pointing at the same ones- but a line belonging to two sizes is not a
 * contradiction, and finding out the hard way would cost a real BoM.
 */
function tec_inventory_tec_product_predelete(EntityInterface $entity) {
  if (!$entity instanceof FieldableEntityInterface) {
    return;
  }
  _tec_inventory_invalidate_pattern_products($entity);
  _tec_inventory_borrandose((int) $entity->id(), TRUE);

  $cascada = [
    'tec_product' => ['field_tec_color_variations', 'field_tec_product', 'tec_color_variation'],
    'tec_color_variation' => ['field_tec_size_variations', 'field_tec_color_variation', 'tec_size_variation'],
  ];
  if (isset($cascada[$entity->bundle()])) {
    $storage = \Drupal::entityTypeManager()->getStorage('tec_product');
    foreach (_tec_inventory_hijos_de($entity, ...$cascada[$entity->bundle()]) as $hijo) {
      $storage->load($hijo)?->delete();
    }
    return;
  }

  if (
    $entity->bundle() !== 'tec_size_variation'
    || !$entity->hasField('field_tec_bom')
    || $entity->get('field_tec_bom')->isEmpty()
  ) {
    return;
  }
  $storage = \Drupal::entityTypeManager()->getStorage('tec_inventory');
  foreach ($entity->get('field_tec_bom')->getValue() as $valor) {
    $otra = \Drupal::entityTypeManager()->getStorage('tec_product')->getQuery()
      ->accessCheck(FALSE)
      ->condition('field_tec_bom', $valor['target_id'])
      ->condition('id', $entity->id(), '<>')
      ->range(0, 1)
      ->execute();
    if ($otra) {
      continue;
    }
    $storage->load($valor['target_id'])?->delete();
  }
}

/**
 * Implements hook_ENTITY_TYPE_delete() for tec_product.
 *
 * Drupal does not tidy up after a deleted entity: the number stays on every
 * list that mentioned it, pointing at nothing. On screen it looks harmless,
 * because a view skips what it cannot load, but the ECA deletion routine walks
 * those lists one by one and stops the moment an entry fails to load. So a
 * single dead number in the middle of a color's size list is enough to leave
 * every size after it alive when the color is deleted.
 *
 * Nothing is touched when the parent is on its way out too, which is the normal
 * case in a cascade: there is no sense saving a list that is about to be
 * deleted, and doing it would drag the parent through a full save while it is
 * halfway through its own deletion.
 */
function tec_inventory_tec_product_delete(EntityInterface $entity) {
  $listas = [
    'tec_color_variation' => 'field_tec_color_variations',
    'tec_size_variation' => 'field_tec_size_variations',
  ];
  if (!$entity instanceof FieldableEntityInterface || !isset($listas[$entity->bundle()])) {
    return;
  }
  $lista = $listas[$entity->bundle()];

  $storage = \Drupal::entityTypeManager()->getStorage('tec_product');
  $padres = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition($lista, $entity->id())
    ->execute();
  foreach ($storage->loadMultiple($padres) as $padre) {
    if (_tec_inventory_borrandose((int) $padre->id())) {
      continue;
    }
    $padre->set($lista, array_values(array_filter(
      $padre->get($lista)->getValue(),
      static fn(array $valor): bool => (int) $valor['target_id'] !== (int) $entity->id()
    )));
    $padre->save();
  }
}

/**
 * Whether an entity is already on its way out.
 */
function _tec_inventory_borrandose(int $id, bool $marcar = FALSE): bool {
  static $marcados = [];
  if ($marcar) {
    $marcados[$id] = TRUE;
  }
  return isset($marcados[$id]);
}

/**
 * The children of a product or a color, by both threads at once.
 *
 * @return int[]
 *   The ids on the parent's list plus any that point up at it without being on
 *   it, which is the state the tree lands in when something is created in an
 *   unexpected order.
 */
function _tec_inventory_hijos_de(FieldableEntityInterface $entity, string $lista, string $vuelta, string $paquete): array {
  $hijos = [];
  if ($entity->hasField($lista)) {
    foreach ($entity->get($lista)->getValue() as $valor) {
      $hijos[(int) $valor['target_id']] = (int) $valor['target_id'];
    }
  }
  foreach (\Drupal::entityTypeManager()->getStorage('tec_product')->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', $paquete)
    ->condition($vuelta, $entity->id())
    ->execute() as $id) {
    $hijos[(int) $id] = (int) $id;
  }
  return $hijos;
}

/**
 * Implements hook_ENTITY_TYPE_insert() for tec_product.
 */
function tec_inventory_tec_product_insert(EntityInterface $entity) {
  _tec_inventory_tie_children_back($entity);
  _tec_inventory_invalidate_pattern_products($entity);
  if ($entity instanceof FieldableEntityInterface && $entity->bundle() === 'tec_color_variation') {
    PatternRecipe::ensureSizes($entity);
  }
}

/**
 * Implements hook_ENTITY_TYPE_update() for tec_product.
 */
function tec_inventory_tec_product_update(EntityInterface $entity) {
  _tec_inventory_tie_children_back($entity);
  _tec_inventory_invalidate_pattern_products($entity, $entity->original ?? NULL);
  if ($entity instanceof FieldableEntityInterface && $entity->bundle() === 'tec_color_variation') {
    PatternRecipe::ensureSizes($entity);
  }
}

/**
 * Pattern list and pattern ficha cache the products that hang from a pattern.
 */
function _tec_inventory_invalidate_pattern_products(EntityInterface $entity, ?EntityInterface $previous = NULL): void {
  if (!$entity instanceof FieldableEntityInterface || $entity->bundle() !== 'tec_product') {
    return;
  }
  if (!$entity->hasField(PatternRecipe::PATTERN_FIELD)) {
    return;
  }
  $ids = [];
  $now = (int) $entity->get(PatternRecipe::PATTERN_FIELD)->target_id;
  if ($now > 0) {
    $ids[] = $now;
  }
  if ($previous instanceof FieldableEntityInterface && $previous->hasField(PatternRecipe::PATTERN_FIELD)) {
    $old = (int) $previous->get(PatternRecipe::PATTERN_FIELD)->target_id;
    if ($old > 0) {
      $ids[] = $old;
    }
  }
  PatternRecipe::invalidateProductLists($ids);
}

/**
 * Make sure everything a product or a color lists points back at it.
 *
 * Presave can only fill a size's way back up the tree by asking who lists it,
 * and at the instant a size is first written nobody does yet: the nested inline
 * form saves the children first and the color that will hold them a moment
 * later. So the size is born with the link empty and, unless something saves it
 * again, it stays empty forever. That is how both sizes of the only product on
 * the site ended up orphaned in plain sight.
 *
 * The parent's save is the first moment the answer exists, so that is where the
 * question gets asked. Only children that are actually missing the link get
 * saved, which is what keeps this from turning into a cascade: fixing a size
 * touches no colors, and a second save of the same color finds nothing to do.
 */
function _tec_inventory_tie_children_back(EntityInterface $entity) {
  static $trabajando = FALSE;
  if ($trabajando || !$entity instanceof FieldableEntityInterface) {
    return;
  }

  $listas = [
    'tec_product' => ['field_tec_color_variations', 'field_tec_product'],
    'tec_color_variation' => ['field_tec_size_variations', 'field_tec_color_variation'],
  ];
  if (!isset($listas[$entity->bundle()])) {
    return;
  }
  [$lista, $vuelta] = $listas[$entity->bundle()];
  if (!$entity->hasField($lista) || $entity->get($lista)->isEmpty()) {
    return;
  }

  $storage = \Drupal::entityTypeManager()->getStorage('tec_product');
  $trabajando = TRUE;
  try {
    foreach ($entity->get($lista)->getValue() as $valor) {
      $hijo = $storage->load($valor['target_id']);
      if (
        $hijo instanceof FieldableEntityInterface
        && $hijo->hasField($vuelta)
        && $hijo->get($vuelta)->isEmpty()
      ) {
        $hijo->set($vuelta, $entity->id());
        $hijo->save();
      }
    }
  }
  finally {
    $trabajando = FALSE;
  }
}

/**
 * Tie a size back to the color that already lists it.
 *
 * The bond between a color and its sizes is written twice: the color keeps them
 * on field_tec_size_variations, and each size points back through
 * field_tec_color_variation. Only the first half is needed to draw the product
 * page, so a size born inside the nested inline form can live for months with
 * the second half empty and look perfectly fine on screen.
 *
 * It stops looking fine the moment something walks the tree upwards. Duplicating
 * a size reads the color off the size to give the copy the same parent, and when
 * it finds nothing it does not complain: the action that loads a reference
 * answers "no entity available", which ECA reads as access denied, so the branch
 * is cut without a line in the log. No copy, no error, and the flag that the
 * icon raised is never lowered, so the button turns into the stock "Unflag this
 * item" and the whole thing looks like the button is broken. That is exactly
 * what sizes 1039 and 1040 of RISE BOXING GLOVE VE SEMI did on 17 August 2026.
 */
function _tec_inventory_keep_color_shortcut(FieldableEntityInterface $entity) {
  if (
    !$entity->hasField('field_tec_color_variation')
    || !$entity->get('field_tec_color_variation')->isEmpty()
    || !$entity->id()
  ) {
    return;
  }
  $color = _tec_inventory_who_lists((int) $entity->id(), 'field_tec_size_variations');
  if ($color !== NULL) {
    $entity->set('field_tec_color_variation', $color);
  }
}

/**
 * Keep a product, color or size named after the field its name is deduced from.
 *
 * Nobody types these names. The product's comes from field_product_name, the
 * color's from its Color term and the size's from its Size term, and in all
 * three the title itself is hidden in the form, so a name left behind is
 * invisible from the screen it belongs to.
 *
 * All three ECA processes that filled these titles shared one rule -act on
 * insert, or only while the title is still empty- and a clone is born with the
 * original's title already in place, which puts it out of reach of that rule
 * forever. Color variation 816 lived for months with the term White and the
 * title Black. The product is worse: its title is set from the insert only,
 * with no update process behind it at all, so any rename left the two apart
 * permanently.
 *
 * It leaks. A line item's title is stamped from [productLoaded:title] down one
 * path and from [productLoaded:field_product_name] down another, so a product
 * carrying two names shows one of them on one document and the other on the
 * next, with nothing to say which is current.
 *
 * The product also gets the capital on every word that creation gives it, so
 * renaming and creating leave the catalog written the same way.
 */
function _tec_inventory_name_from_source(FieldableEntityInterface $entity) {
  $name = match ($entity->bundle()) {
    'tec_product' => _tec_inventory_product_name($entity),
    'tec_color_variation' => _tec_inventory_term_label($entity, 'field_tec_colors'),
    'tec_size_variation' => _tec_inventory_term_label($entity, 'field_tec_size'),
    default => NULL,
  };
  if ($name !== NULL && $name !== '' && $entity->label() !== $name) {
    $entity->set('title', $name);
  }
}

/**
 * A product's name, capitalised the way the creation form capitalises it.
 *
 * @return string|null
 *   The name, or NULL when there is nothing written to take it from.
 */
function _tec_inventory_product_name(FieldableEntityInterface $entity): ?string {
  if (!$entity->hasField('field_product_name') || $entity->get('field_product_name')->isEmpty()) {
    return NULL;
  }
  $written = trim((string) $entity->get('field_product_name')->value);
  if ($written === '') {
    return NULL;
  }
  $name = ucwords($written);
  if ($name !== $entity->get('field_product_name')->value) {
    $entity->set('field_product_name', $name);
  }
  return $name;
}

/**
 * The label of the first term a field points at.
 *
 * @return string|null
 *   The label, or NULL when the field is empty or the term is gone.
 */
function _tec_inventory_term_label(FieldableEntityInterface $entity, string $field): ?string {
  if (!$entity->hasField($field) || $entity->get($field)->isEmpty()) {
    return NULL;
  }
  $term = $entity->get($field)->entity;
  return $term ? $term->label() : NULL;
}

/**
 * Fill the shortcut a color or size keeps straight to its product.
 *
 * Colors and sizes hang off their parent, but they also store field_tec_product
 * pointing at the grandparent, and that shortcut is what the product views join
 * on to build their links. Two ECA processes fill it, "TEC Product: Insert
 * Color entity" and "TEC Product: Insert Size entity", but both listen only to
 * the insert and only act when the link to the parent is already in place at
 * that instant. A size born inside the nested inline form, where its color is
 * still being cooked, misses the window and nothing ever comes back for it: the
 * row keeps showing, but its edit pencil builds /tec_product/ with no number
 * behind the slash, so saving lands on a 404.
 *
 * Running at presave asks the question again on every save, whatever created
 * the entity and in whatever order, and only when the shortcut is missing.
 */
function _tec_inventory_keep_product_shortcut(FieldableEntityInterface $entity) {
  if (!$entity->hasField('field_tec_product') || !$entity->get('field_tec_product')->isEmpty()) {
    return;
  }
  $product = _tec_inventory_product_above($entity);
  if ($product !== NULL) {
    $entity->set('field_tec_product', $product);
  }
}

/**
 * The product a color or size hangs from, by whichever thread is still tied.
 *
 * @return int|null
 *   The product id, or NULL when nothing upstream knows yet.
 */
function _tec_inventory_product_above(FieldableEntityInterface $entity): ?int {
  if ($entity->bundle() === 'tec_color_variation') {
    return $entity->id() ? _tec_inventory_who_lists((int) $entity->id(), 'field_tec_color_variations') : NULL;
  }

  $color_id = 0;
  if ($entity->hasField('field_tec_color_variation') && !$entity->get('field_tec_color_variation')->isEmpty()) {
    $color_id = (int) $entity->get('field_tec_color_variation')->first()->target_id;
  }
  elseif ($entity->id()) {
    $color_id = (int) _tec_inventory_who_lists((int) $entity->id(), 'field_tec_size_variations');
  }
  if ($color_id === 0) {
    return NULL;
  }

  $color = \Drupal::entityTypeManager()->getStorage('tec_product')->load($color_id);
  if (
    $color instanceof FieldableEntityInterface
    && $color->hasField('field_tec_product')
    && !$color->get('field_tec_product')->isEmpty()
  ) {
    return (int) $color->get('field_tec_product')->first()->target_id;
  }

  // The color is as lost as the size, so ask who has it on their list.
  return _tec_inventory_who_lists($color_id, 'field_tec_color_variations');
}

/**
 * Who keeps this entity on the given list, if anyone.
 *
 * @return int|null
 *   The id of the entity listing it, or NULL.
 */
function _tec_inventory_who_lists(int $child, string $field): ?int {
  $ids = \Drupal::entityTypeManager()->getStorage('tec_product')->getQuery()
    ->accessCheck(FALSE)
    ->condition($field, $child)
    ->range(0, 1)
    ->execute();
  return $ids ? (int) reset($ids) : NULL;
}

/**
 * Implements hook_inline_entity_form_entity_form_alter().
 *
 * IEF "Create BoM item" keeps the entity unsaved until the parent Save, so
 * hook_entity_presave() has not run yet when the table row is rendered.
 * Apply the formula while building the inline entity.
 */
function tec_inventory_inline_entity_form_entity_form_alter(array &$entity_form, FormStateInterface &$form_state) {
  if (($entity_form['#entity_type'] ?? '') === 'tec_inventory' && ($entity_form['#bundle'] ?? '') === 'tec_bom_item') {
    $entity_form['#entity_builders'][] = 'tec_inventory_bom_item_entity_builder';
    return;
  }
  if (($entity_form['#entity_type'] ?? '') === 'tec_product') {
    $entity = $entity_form['#entity'] ?? NULL;
    if ($entity instanceof FieldableEntityInterface) {
      _tec_inventory_alter_catalogue_form($entity_form, $form_state, $entity);
    }
  }
}

/**
 * Entity builder: parse Production requires into field_tec_quantity.
 */
function tec_inventory_bom_item_entity_builder($entity_type, FieldableEntityInterface $entity, array &$form, FormStateInterface &$form_state) {
  _tec_inventory_apply_quantity_formula($entity);
}

/**
 * Implements hook_ENTITY_TYPE_presave() for taxonomy_term.
 *
 * Derive Inventory Cost and Consumption Cost from the purchase cost and the two
 * conversion factors. A JavaScript on the material form has been doing this for
 * years, which means the two figures only ever existed when someone had the form
 * open in a browser: materials created by code — the importer, ECA duplicates,
 * scripts — were saved with both empty, and those are the numbers every costing
 * view divides by. Running at presave covers every path without extra saves or
 * recursion, the same reason the color variation title moved here.
 *
 * The JavaScript stays, but only for what needs a browser: showing the two
 * figures update while the purchase cost is being typed.
 */
function tec_inventory_taxonomy_term_presave(EntityInterface $entity) {
  if ($entity->bundle() !== 'tec_inventory' || !$entity instanceof FieldableEntityInterface) {
    return;
  }

  _tec_inventory_apply_derived_costs($entity);
}

/**
 * Divide the purchase cost down through the two conversion factors.
 */
function _tec_inventory_apply_derived_costs(FieldableEntityInterface $entity): void {
  $needed = [
    'field_tec_cost',
    'field_tec_units',
    'field_tec_split_into',
    'field_tec_price_uos',
    'field_tec_price',
  ];
  foreach ($needed as $name) {
    if (!$entity->hasField($name)) {
      return;
    }
  }

  $number = function (string $name) use ($entity): ?float {
    $list = $entity->get($name);
    if ($list->isEmpty()) {
      return NULL;
    }
    $value = $list->first()->value;
    return is_numeric($value) ? (float) $value : NULL;
  };

  $cost = $number('field_tec_cost');
  $to_inventory = $number('field_tec_units');
  $to_consumption = $number('field_tec_split_into');

  // A half-filled material has no cost to state. Treating a missing factor as 1
  // would store the purchase cost as if it were the unit cost, which reads as a
  // real figure and is wrong by the whole conversion.
  if (!($cost > 0) || !($to_inventory > 0) || !($to_consumption > 0)) {
    $entity->set('field_tec_price_uos', NULL);
    $entity->set('field_tec_price', NULL);
    return;
  }

  $per_inventory_unit = $cost / $to_inventory;

  // The consumption cost divides the unrounded figure, not the stored inventory
  // cost: rounding first and then dividing would multiply that rounding by the
  // second factor, which is where the real money is.
  $entity->set('field_tec_price_uos', round($per_inventory_unit, _tec_inventory_field_scale($entity, 'field_tec_price_uos')));
  $entity->set('field_tec_price', round($per_inventory_unit / $to_consumption, _tec_inventory_field_scale($entity, 'field_tec_price')));
}

/**
 * How many decimals a decimal field can actually store.
 */
function _tec_inventory_field_scale(FieldableEntityInterface $entity, string $name): int {
  return (int) $entity->get($name)
    ->getFieldDefinition()
    ->getFieldStorageDefinition()
    ->getSetting('scale');
}

/**
 * How many referring entities to name before saying "and N more".
 */
const TEC_INVENTORY_USAGES_SHOWN = 10;

/**
 * Implements hook_form_alter().
 *
 * Refuse to delete a material that something still points at, and say what.
 *
 * Deleting one used to break the lines that use it, silently, which is the worst
 * way for it to break. Nothing stops the delete: the reference is left dangling,
 * and the next time ECA recalculates that line it tries to load the material,
 * gets nothing, and the load action answers "access denied — no entity
 * available". ECA writes that to the log as a warning and stops the chain right
 * there, which means it never reaches the step that clears the lock flag. The
 * line keeps the flag, and a flagged line never recalculates again — not even
 * after the material is put back. The total just quietly stops being true.
 *
 * That is why this blocks instead of warning. The damage is invisible, it lands
 * on a different entity than the one being deleted, and it does not undo itself.
 *
 * Only the form is guarded, on purpose. Deleting by code stays open, because the
 * cleanup scripts delete materials by the hundred and they already handle the
 * order themselves, from the leaves to the trunk. A hard block in presave would
 * break them for no gain: a script is not somebody clicking Delete by mistake.
 */
function tec_inventory_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $form_object = $form_state->getFormObject();
  if ($form_object instanceof EntityFormInterface) {
    $entity = $form_object->getEntity();
    if ($entity instanceof FieldableEntityInterface && $entity->getEntityTypeId() === 'tec_product') {
      _tec_inventory_alter_catalogue_form($form, $form_state, $entity);
    }
  }

  if ($form_id !== 'taxonomy_term_tec_inventory_delete_form') {
    return;
  }

  if (!$form_object instanceof EntityFormInterface) {
    return;
  }
  $usages = _tec_inventory_material_usages($form_object->getEntity());
  if (!$usages['total']) {
    return;
  }

  $form['tec_inventory_in_use'] = [
    '#theme' => 'status_messages',
    '#message_list' => [
      'error' => [
        t('This material cannot be deleted: @count things still use it. Deleting it would stop their totals from ever being recalculated, without any warning. Take it out of the list below first.', [
          '@count' => $usages['total'],
        ]),
      ],
    ],
    '#weight' => -100,
  ];

  foreach ($usages['groups'] as $group => $items) {
    $form['tec_inventory_in_use_' . preg_replace('/[^a-z0-9_]/', '_', strtolower($group))] = [
      '#theme' => 'item_list',
      '#title' => $group,
      '#items' => $items,
      '#weight' => -90,
    ];
  }

  // With the button gone there is no way through the form. The validator is for
  // a submission that arrives without it.
  unset($form['actions']['submit']);
  $form['#validate'][] = '_tec_inventory_refuse_to_delete_a_used_material';
}

/**
 * Form validator: last stop for a delete that got past the missing button.
 */
function _tec_inventory_refuse_to_delete_a_used_material(array &$form, FormStateInterface $form_state): void {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof EntityFormInterface) {
    return;
  }
  if (_tec_inventory_material_usages($form_object->getEntity())['total']) {
    $form_state->setErrorByName('', t('This material is in use and cannot be deleted.'));
  }
}

/**
 * Find what points at a material, by name.
 *
 * Asks the field definitions which fields can reference a taxonomy term and
 * queries every one of them, instead of naming the two that do it today. The
 * configuration is not reliable here: field_tec_inventory on tec_bom_item does
 * not declare target_bundles, so by configuration alone there is no way to tell
 * that it points at materials. Querying by term ID sidesteps the question, and a
 * field added later is covered without anyone remembering to come back here.
 *
 * @return array
 *   'total' is how many were found, capped. 'groups' maps a human name for the
 *   kind of thing to a list of links, ready for an item_list.
 */
function _tec_inventory_material_usages(EntityInterface $material): array {
  $groups = [];
  $total = 0;

  $entity_type_manager = \Drupal::entityTypeManager();
  $bundle_info = \Drupal::service('entity_type.bundle.info');

  foreach ($entity_type_manager->getStorage('field_storage_config')->loadMultiple() as $field_storage) {
    if (!in_array($field_storage->getType(), ['entity_reference', 'entity_reference_revisions'], TRUE)) {
      continue;
    }
    if ($field_storage->getSetting('target_type') !== 'taxonomy_term') {
      continue;
    }

    $entity_type_id = $field_storage->getTargetEntityTypeId();
    $field_name = $field_storage->getName();

    try {
      $storage = $entity_type_manager->getStorage($entity_type_id);
      // Counted apart from what gets loaded, so the figure in the message is the
      // real one and not however many fitted in the list.
      $count = (int) $storage->getQuery()
        ->accessCheck(FALSE)
        ->condition($field_name, $material->id())
        ->count()
        ->execute();
      if (!$count) {
        continue;
      }
      $ids = $storage->getQuery()
        ->accessCheck(FALSE)
        ->condition($field_name, $material->id())
        ->range(0, TEC_INVENTORY_USAGES_SHOWN)
        ->execute();
    }
    catch (\Throwable $e) {
      // An entity type without a queryable field is not a usage.
      continue;
    }
    $total += $count;

    foreach ($storage->loadMultiple($ids) as $referring) {
      $bundles = $bundle_info->getBundleInfo($entity_type_id);
      $group = (string) ($bundles[$referring->bundle()]['label'] ?? $entity_type_id);
      if (count($groups[$group] ?? []) >= TEC_INVENTORY_USAGES_SHOWN) {
        continue;
      }

      // Naming the referring entity itself is no help: a BoM item and a purchase
      // order line are both titled after the material, so the list would come
      // out as the same word repeated. What the reader needs is the product or
      // the order it sits in.
      $context = _tec_inventory_usage_context($referring);
      $label = (string) ($context ?? $referring)->label();
      if ($label === '') {
        $label = (string) t('Untitled (@id)', ['@id' => $referring->id()]);
      }
      try {
        $groups[$group][] = [
          '#type' => 'link',
          '#title' => $label,
          '#url' => ($context ?? $referring)->toUrl(),
        ];
      }
      catch (\Throwable $e) {
        // Plenty of things in this ERP have no page of their own.
        $groups[$group][] = ['#markup' => $label];
      }
    }
  }

  return [
    'total' => $total,
    'groups' => $groups,
  ];
}

/**
 * Walk up from a thing that uses a material to something worth naming.
 *
 * A BoM item hangs off a size variation, a purchase order line off its order,
 * and a line item BoM item off another BoM item, which needs one more hop before
 * it reaches the size variation. So the walk keeps going through the plumbing and
 * stops at the first order or product, which are the two things a person can
 * actually go and look at.
 *
 * @return \Drupal\Core\Entity\EntityInterface|null
 *   The order or product this sits in, or NULL when there is no way up.
 */
function _tec_inventory_usage_context(EntityInterface $entity, int $hops = 3): ?EntityInterface {
  $worth_naming = ['tec_order', 'tec_product'];
  $plumbing = ['tec_inventory', 'tec_line_item'];

  while ($hops-- > 0) {
    if (!$entity instanceof FieldableEntityInterface) {
      return NULL;
    }

    $next = NULL;
    foreach ($entity->getFields() as $items) {
      $definition = $items->getFieldDefinition();
      if ($definition->getType() !== 'entity_reference' || $items->isEmpty()) {
        continue;
      }
      $target = $definition->getSetting('target_type');
      if (in_array($target, $worth_naming, TRUE) && $items->entity) {
        return $items->entity;
      }
      if ($next === NULL && in_array($target, $plumbing, TRUE) && $items->entity) {
        $next = $items->entity;
      }
    }

    if ($next === NULL) {
      return NULL;
    }
    $entity = $next;
  }

  return NULL;
}

/**
 * Copy a parseable formula/decimal from quantity_input into quantity.
 */
function _tec_inventory_apply_quantity_formula(FieldableEntityInterface $entity) {
  if (
    !$entity->hasField('field_tec_quantity_input')
    || !$entity->hasField('field_tec_quantity')
    || $entity->get('field_tec_quantity_input')->isEmpty()
  ) {
    return;
  }

  $raw = trim((string) $entity->get('field_tec_quantity_input')->value);
  $decimal = _tec_inventory_parse_quantity_formula($raw);
  if ($decimal === NULL) {
    return;
  }

  // Match decimal field scale (4).
  $entity->set('field_tec_quantity', round($decimal, 4));
}

/**
 * Implements hook_inline_entity_form_table_fields_alter().
 *
 * Show Production requires from entity fields directly. The old viewfield
 * column used [tec_inventory:id], which is empty for unsaved IEF rows.
 */
function tec_inventory_inline_entity_form_table_fields_alter(array &$fields, array $context) {
  if (($context['entity_type'] ?? '') !== 'tec_inventory') {
    return;
  }
  if (($context['field_name'] ?? '') !== 'field_tec_bom') {
    return;
  }
  if (empty($context['allowed_bundles']) || !in_array('tec_bom_item', $context['allowed_bundles'], TRUE)) {
    return;
  }

  unset($fields['field_tec_production_requires_vf'], $fields['field_tec_quantity'], $fields['field_tec_quantity_input']);
  $fields['tec_production_requires'] = [
    'type' => 'callback',
    'label' => t('Production requires'),
    'weight' => 1,
    'callback' => 'tec_inventory_ief_production_requires_column',
  ];
}

/**
 * IEF table callback: render quantity (+ original formula when present).
 */
function tec_inventory_ief_production_requires_column($entity, array $variables = []) {
  if (!$entity instanceof FieldableEntityInterface) {
    return ['#markup' => ''];
  }

  _tec_inventory_apply_quantity_formula($entity);

  $parts = [];
  if ($entity->hasField('field_tec_quantity') && !$entity->get('field_tec_quantity')->isEmpty()) {
    $parts[] = number_format((float) $entity->get('field_tec_quantity')->value, 4, '.', '');
  }
  if ($entity->hasField('field_tec_quantity_input') && !$entity->get('field_tec_quantity_input')->isEmpty()) {
    $input = trim((string) $entity->get('field_tec_quantity_input')->value);
    // A plain number is already the figure on the left, whatever its trailing
    // zeros. Only a formula, or text nobody could parse, says anything new.
    if ($input !== '' && !is_numeric($input)) {
      $parts[] = $input;
    }
  }

  return [
    '#markup' => $parts ? implode(' · ', $parts) : '',
  ];
}

/**
 * Parse a plain decimal or simple fraction (a/b) into a float.
 *
 * @param string $raw
 *   User input.
 *
 * @return float|null
 *   Parsed value, or NULL if not parseable.
 */
function _tec_inventory_parse_quantity_formula($raw) {
  if ($raw === '') {
    return NULL;
  }

  // Plain decimal / integer (optional leading sign).
  if (preg_match('/^[+-]?\d+(\.\d+)?$/', $raw)) {
    return (float) $raw;
  }

  // Fraction a/b — numerator and denominator may be decimals (e.g. 1/12, 1/2.5, 1.1/2).
  if (preg_match('/^([+-]?\d+(?:\.\d+)?)\s*\/\s*(\d+(?:\.\d+)?)$/', $raw, $matches)) {
    $denominator = (float) $matches[2];
    if ($denominator == 0.0) {
      return NULL;
    }
    return ((float) $matches[1]) / $denominator;
  }

  return NULL;
}

/**
 * Implements hook_theme().
 */
function tec_inventory_theme($existing, $type, $theme, $path) {
  return [
    'tec_order_production_documents' => [
      'variables' => [
        'order_label' => '',
        'order_id' => NULL,
        'grand_total' => 0,
        'products' => [],
      ],
      'template' => 'tec-order-production-documents',
    ],
  ];
}

/**
 * Implements hook_entity_view().
 *
 * A size on a pattern shows the assembled recipe, not the (empty) size BoM view.
 */
function tec_inventory_entity_view(array &$build, EntityInterface $entity, $display, $view_mode): void {
  if ($entity->getEntityTypeId() !== 'tec_product') {
    return;
  }
  if (PatternRecipe::hasPattern($entity)) {
    // Empty arrays, not unset: Layout Builder copies these into ExtraFieldBlock
    // placeholders. An empty extra field lets the block abort instead of
    // leaving the "Placeholder for…" markup.
    $build['flag_tec_product_duplicate_size'] = [];
    $build['flag_tec_product_duplicate_color'] = [];
    if (isset($build['field_tec_create_size'])) {
      $build['field_tec_create_size']['#access'] = FALSE;
    }
  }
  if ($entity->bundle() === 'tec_color_variation') {
    return;
  }
  if ($entity->bundle() !== 'tec_size_variation') {
    return;
  }
  if (!PatternRecipe::hasPattern($entity)) {
    return;
  }
  $editable = $entity->access('update');
  $recipe = PatternRecipe::tableBuild($entity, FALSE, !$editable);
  $build['#cache']['contexts'][] = 'user.permissions';
  if (isset($build['field_tec_view_bill_of_materials'])) {
    foreach (Element::children($build['field_tec_view_bill_of_materials']) as $delta) {
      unset($build['field_tec_view_bill_of_materials'][$delta]);
    }
    $build['field_tec_view_bill_of_materials'][0] = $recipe;
  }
  else {
    $build['field_tec_view_bill_of_materials'] = $recipe;
  }
  $build['#attached']['library'][] = 'tec_inventory/pattern';
}

/**
 * Hide Oscar's empty Pattern field; add pattern holes on the colour; lock sizes.
 */
function _tec_inventory_alter_catalogue_form(array &$form, FormStateInterface $form_state, FieldableEntityInterface $entity): void {
  $form['#attached']['library'][] = 'tec_inventory/pattern';
  if (!empty($form['field_tec_pattern'])) {
    $form['field_tec_pattern']['#access'] = FALSE;
  }
  if ($entity->bundle() === 'tec_product') {
    _tec_inventory_alter_product_form($form, $form_state, $entity);
    return;
  }
  if ($entity->bundle() === 'tec_color_variation') {
    _tec_inventory_alter_color_holes_form($form, $form_state, $entity);
    return;
  }
  if ($entity->bundle() === 'tec_size_variation') {
    _tec_inventory_alter_size_recipe_form($form, $form_state, $entity);
  }
}

/**
 * Product add is name/type/pattern only. Edit is where colours and photos go.
 *
 * Save on add ignores ?destination= and opens this product's edit. Save on
 * edit ignores it too and opens the ficha. Cancel can still use destination.
 */
function _tec_inventory_alter_product_form(array &$form, FormStateInterface $form_state, FieldableEntityInterface $entity): void {
  if (!empty($form['field_tec_create_color'])) {
    $form['field_tec_create_color']['#access'] = FALSE;
  }
  if (!empty($form['field_tec_color_embed_vm'])) {
    $form['field_tec_color_embed_vm']['#access'] = FALSE;
  }
  if ($entity->isNew() && !empty($form['field_tec_color_variations'])) {
    $form['field_tec_color_variations']['#access'] = FALSE;
  }
  elseif (!$entity->isNew() && PatternRecipe::hasPattern($entity) && !empty($form['field_tec_color_variations'])) {
    $form['field_tec_color_variations']['#description'] = t('Add each colour with its photo. Fill Pattern here. Sizes of this pattern are created when you save. Extras are added on the product.');
  }

  if ($form_state->get('tec_product_is_new') === NULL) {
    $form_state->set('tec_product_is_new', $entity->isNew());
  }
  if ($form_state->get('tec_product_return') === NULL) {
    $dest = \Drupal::request()->query->get('destination');
    if (is_string($dest) && str_starts_with($dest, '/') && !str_starts_with($dest, '//')) {
      $form_state->set('tec_product_return', $dest);
    }
  }
  foreach (['submit', 'publish'] as $key) {
    if (empty($form['actions'][$key]) || !is_array($form['actions'][$key])) {
      continue;
    }
    $form['actions'][$key]['#submit'][] = 'tec_inventory_product_after_save';
  }
}

/**
 * New product → its edit. Existing product → its ficha.
 */
function tec_inventory_product_after_save(array &$form, FormStateInterface $form_state): void {
  $object = $form_state->getFormObject();
  if (!$object instanceof EntityFormInterface) {
    return;
  }
  $entity = $object->getEntity();
  if (!$entity instanceof FieldableEntityInterface || $entity->bundle() !== 'tec_product' || !$entity->id()) {
    return;
  }
  $form_state->setIgnoreDestination(TRUE);
  if ($form_state->get('tec_product_is_new')) {
    $options = [];
    $return = $form_state->get('tec_product_return');
    if (is_string($return) && $return !== '') {
      $options['query']['destination'] = $return;
    }
    $form_state->setRedirectUrl($entity->toUrl('edit-form', $options));
    return;
  }
  $form_state->setRedirectUrl($entity->toUrl());
}

/**
 * Product of this colour/size, including when the parent is still the IEF host.
 */
function _tec_inventory_form_product(FormStateInterface $form_state, FieldableEntityInterface $entity): ?FieldableEntityInterface {
  $found = PatternRecipe::productOf($entity);
  if ($found) {
    return $found;
  }
  if ($entity->hasField('field_tec_product') && !$entity->get('field_tec_product')->isEmpty()) {
    $product = $entity->get('field_tec_product')->entity;
    if ($product instanceof FieldableEntityInterface && $product->bundle() === 'tec_product') {
      return $product;
    }
  }
  $qid = (int) \Drupal::request()->query->get('product_id');
  if ($qid > 0) {
    $product = \Drupal::entityTypeManager()->getStorage('tec_product')->load($qid);
    if ($product instanceof FieldableEntityInterface && $product->bundle() === 'tec_product') {
      return $product;
    }
  }
  $object = $form_state->getFormObject();
  if (!$object instanceof EntityFormInterface) {
    return NULL;
  }
  $host = $object->getEntity();
  if (!$host instanceof FieldableEntityInterface || $host->getEntityTypeId() !== 'tec_product') {
    return NULL;
  }
  if ($host->bundle() === 'tec_product') {
    return $host;
  }
  return PatternRecipe::productOf($host);
}

/**
 * Colour of this size, including when the parent is still the IEF host.
 */
function _tec_inventory_form_color(FormStateInterface $form_state, FieldableEntityInterface $size): ?FieldableEntityInterface {
  $found = PatternRecipe::colorOf($size);
  if ($found) {
    return $found;
  }
  $object = $form_state->getFormObject();
  if (!$object instanceof EntityFormInterface) {
    return NULL;
  }
  $host = $object->getEntity();
  if ($host instanceof FieldableEntityInterface && $host->bundle() === 'tec_color_variation') {
    return $host;
  }
  return NULL;
}

function _tec_inventory_alter_color_holes_form(array &$form, FormStateInterface $form_state, FieldableEntityInterface $entity): void {
  $product = _tec_inventory_form_product($form_state, $entity);
  $pattern = $product ? PatternRecipe::patternOf($product) : NULL;
  if (!$pattern) {
    return;
  }

  if ($form_state->get('tec_color_is_new') === NULL) {
    $form_state->set('tec_color_is_new', $entity->isNew());
  }

  if (!empty($form['field_tec_size_variations'])) {
    $form['field_tec_size_variations']['#access'] = FALSE;
  }
  if (!empty($form['field_tec_create_size'])) {
    $form['field_tec_create_size']['#access'] = FALSE;
  }

  $types = PatternRecipe::yellowTypes($pattern);
  $holes = PatternRecipe::holesOf($entity);
  $form['tec_pattern_holes'] = [
    '#type' => 'fieldset',
    '#title' => t('Fill Pattern'),
    '#description' => t('Yellow cells on @code are types. Pick the SKU this colour uses. Quantity stays on the pattern.', [
      '@code' => $pattern->code(),
    ]),
    '#tree' => TRUE,
    '#weight' => 20,
  ];
  foreach ($types as $tid) {
    $type = Term::load($tid);
    $options = PatternRecipe::skusOfType($tid);
    $form['tec_pattern_holes'][$tid] = [
      '#type' => 'select',
      '#title' => $type ? $type->label() : '#' . $tid,
      '#options' => ['' => t('- Select -')] + $options,
      '#default_value' => isset($holes[$tid]) ? (string) $holes[$tid] : '',
      '#required' => TRUE,
    ];
  }
  if (!$types) {
    $form['tec_pattern_holes']['empty'] = [
      '#markup' => '<p>' . t('This pattern has no yellow types. Greens already have a SKU on the pattern.') . '</p>',
    ];
  }

  if ($entity->isNew()) {
    $form['tec_size_extras'] = [
      '#markup' => '<p class="tec-pattern-help">' . t('Sizes of this pattern are created when you save. Extras are added on the product.') . '</p>',
      '#weight' => 21,
    ];
  }
  else {
    PatternRecipe::ensureSizes($entity);
  }

  $form['#entity_builders'][] = 'tec_inventory_color_recipe_builder';
  foreach (['submit', 'publish'] as $key) {
    if (empty($form['actions'][$key]) || !is_array($form['actions'][$key])) {
      continue;
    }
    $form['actions'][$key]['#submit'][] = 'tec_inventory_color_pattern_after_save';
  }
}

function _tec_inventory_extra_tid($raw): int {
  if (is_array($raw)) {
    $raw = $raw[0]['target_id'] ?? ($raw['target_id'] ?? 0);
  }
  if (is_numeric($raw)) {
    return (int) $raw;
  }
  if (is_string($raw) && $raw !== '') {
    $extracted = \Drupal\Core\Entity\Element\EntityAutocomplete::extractEntityIdFromAutocompleteInput($raw);
    return $extracted ? (int) $extracted : 0;
  }
  return 0;
}

function tec_inventory_color_pattern_after_save(array &$form, FormStateInterface $form_state): void {
  $object = $form_state->getFormObject();
  if (!$object instanceof EntityFormInterface) {
    return;
  }
  $entity = $object->getEntity();
  if (!$entity instanceof FieldableEntityInterface || $entity->bundle() !== 'tec_color_variation') {
    return;
  }
  PatternRecipe::ensureSizes($entity);
  if (!$form_state->get('tec_color_is_new')) {
    return;
  }
  if (!PatternRecipe::hasPattern($entity)) {
    return;
  }
  $product = PatternRecipe::productOf($entity);
  $pid = $product ? (int) $product->id() : 0;
  $cid = (int) $entity->id();
  if ($cid <= 0) {
    return;
  }
  $form_state->setIgnoreDestination(TRUE);
  if ($pid > 0) {
    $form_state->setRedirectUrl(Url::fromUri('internal:/tec_product/' . $pid, [
      'fragment' => (string) $cid,
    ]));
  }
}

function tec_inventory_color_recipe_builder($entity_type, FieldableEntityInterface $entity, array &$form, FormStateInterface $form_state): void {
  if ($entity->bundle() !== 'tec_color_variation') {
    return;
  }
  $holes_values = $form_state->getValue('tec_pattern_holes');
  if ($holes_values === NULL && !empty($form['tec_pattern_holes']['#parents'])) {
    $holes_values = NestedArray::getValue($form_state->getValues(), $form['tec_pattern_holes']['#parents']);
  }
  $holes = [];
  foreach ($holes_values ?: [] as $type_id => $sku_id) {
    if (!is_numeric($type_id)) {
      continue;
    }
    $holes[(int) $type_id] = (int) $sku_id;
  }
  PatternRecipe::setHoles($entity, $holes);

  $by_size = $form_state->getValue('tec_size_extras');
  if ($by_size === NULL && !empty($form['tec_size_extras']['#parents'])) {
    $by_size = NestedArray::getValue($form_state->getValues(), $form['tec_size_extras']['#parents']);
  }
  if (!is_array($by_size)) {
    return;
  }
  $storage = \Drupal::entityTypeManager()->getStorage('tec_product');
  foreach ($by_size as $size_id => $rows) {
    if (!is_numeric((string) $size_id) || !is_array($rows)) {
      continue;
    }
    $size = $storage->load((int) $size_id);
    if (!$size instanceof FieldableEntityInterface || $size->bundle() !== 'tec_size_variation') {
      continue;
    }
    $extras = [];
    foreach ($rows as $key => $row) {
      if (!is_numeric((string) $key) || !is_array($row)) {
        continue;
      }
      $extras[] = [
        'target_id' => _tec_inventory_extra_tid($row['target_id'] ?? 0),
        'qty' => trim((string) ($row['qty'] ?? '')),
      ];
    }
    PatternRecipe::setExtras($size, $extras);
    $size->save();
  }
  PatternRecipe::setExtras($entity, []);
}

function _tec_inventory_alter_size_recipe_form(array &$form, FormStateInterface $form_state, FieldableEntityInterface $entity): void {
  $product = _tec_inventory_form_product($form_state, $entity);
  $pattern = $product ? PatternRecipe::patternOf($product) : NULL;
  if (!$pattern) {
    return;
  }

  $allowed = $pattern->sizeIds();
  $color = _tec_inventory_form_color($form_state, $entity);
  $used = $color ? PatternRecipe::usedSizeTermIds($color, (int) $entity->id()) : [];
  $keep = array_values(array_diff($allowed, $used));
  $current = PatternRecipe::sizeTermId($entity);
  if ($current > 0) {
    $keep[] = $current;
  }
  _tec_inventory_restrict_size_options($form, $keep);

  if (!empty($form['field_tec_bom'])) {
    $form['field_tec_bom']['#access'] = FALSE;
  }

  if ($current > 0) {
    $form['tec_pattern_recipe'] = PatternRecipe::tableBuild($entity);
    $form['tec_pattern_recipe']['#weight'] = 2;
  }
  else {
    $form['tec_pattern_recipe'] = [
      '#markup' => '<p class="tec-pattern-help">' . t('Bill of materials comes from pattern @code. Greens are not edited here.', [
        '@code' => $pattern->code(),
      ]) . '</p>',
      '#weight' => 2,
    ];
  }

  $form['#tec_pattern_size_ids'] = $allowed;
  $form['#tec_pattern_used_ids'] = $used;
  $form['#validate'][] = 'tec_inventory_size_pattern_validate';
}

function _tec_inventory_restrict_size_options(array &$form, array $keep): void {
  if (empty($form['field_tec_size'])) {
    return;
  }
  $allowed = array_flip(array_map('intval', $keep));
  $filter = static function (array &$el) use (&$filter, $allowed): void {
    if (isset($el['#options']) && is_array($el['#options'])) {
      $el['#options'] = array_filter($el['#options'], static function ($label, $key) use ($allowed) {
        if ($key === '' || $key === '_none' || $key === NULL) {
          return TRUE;
        }
        return isset($allowed[(int) $key]);
      }, ARRAY_FILTER_USE_BOTH);
    }
    foreach ($el as $k => &$child) {
      if (is_string($k) && $k !== '' && $k[0] !== '#' && is_array($child)) {
        $filter($child);
      }
    }
  };
  $filter($form['field_tec_size']);
}

function tec_inventory_size_pattern_validate(array &$form, FormStateInterface $form_state): void {
  $allowed = $form['#tec_pattern_size_ids'] ?? [];
  if (!$allowed) {
    return;
  }
  $sid = _tec_inventory_submitted_size_tid($form_state);
  if ($sid <= 0) {
    return;
  }
  if (!in_array($sid, array_map('intval', $allowed), TRUE)) {
    $form_state->setErrorByName('field_tec_size', t('This pattern is not cut in that size.'));
    return;
  }
  $used = $form['#tec_pattern_used_ids'] ?? [];
  if (in_array($sid, array_map('intval', $used), TRUE)) {
    $form_state->setErrorByName('field_tec_size', t('This colour already has that size.'));
  }
}

function _tec_inventory_submitted_size_tid(FormStateInterface $form_state): int {
  $v = $form_state->getValue('field_tec_size');
  if (is_numeric($v)) {
    return (int) $v;
  }
  if (!is_array($v)) {
    return 0;
  }
  if (isset($v[0]['target_id'])) {
    return (int) $v[0]['target_id'];
  }
  if (isset($v['target_id'])) {
    return (int) $v['target_id'];
  }
  return 0;
}

